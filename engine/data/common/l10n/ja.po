#: engine/lua/match3/game.lua
msgid "MOVE"
msgstr "移動"

#: engine/lua/match3/game.lua
msgid "Match-3 town"
msgstr "マッチ3の町"

#: engine/lua/match3/game.lua
msgid "OPEN THIS AREA"
msgstr "このエリアを開く"

