#: engine/lua/match3/game.lua
#, lua-format
msgid "OPENS IN %s"
msgstr "%sで開放"

#: engine/lua/match3/game.lua
msgid "Out of moves"
msgstr "手数切れ"

#: engine/lua/match3/game.lua
msgid "PLAY"
