#. TRANSLATORS: follows the player's own name in the leaderboard
#: engine/lua/leaderboard.lua
msgid "(you)"
msgstr "（あなた）"

#: engine/lua/leaderboard.lua
msgid "Close"
msgstr "閉じる"

#: engine/lua/leaderboard.lua
msgid "Everyone"
msgstr "みんな"

#: engine/lua/leaderboard.lua
msgid "Friends"
msgstr "フレンド"

#: engine/lua/leaderboard.lua
msgid "Leaderboard"
msgstr "ランキング"

#: engine/lua/leaderboard.lua
msgid "Loading..."
msgstr "読み込み中…"

#: engine/lua/leaderboard.lua
msgid "No scores yet. Be the first!"
msgstr "まだスコアがありません。一番乗りになろう！"

#: engine/lua/leaderboard.lua
msgid "None of your friends have played yet."
msgstr "まだフレンドの誰もプレイしていません。"

#: engine/lua/leaderboard.lua
msgid "Sign in to Game Center to compare with other players."
msgstr "Game Centerにサインインして、ほかのプレイヤーと競おう。"

#: engine/lua/leaderboard.lua
msgid "Sign in to Game Center to see your friends."
msgstr "Game Centerにサインインして、フレンドを見よう。"

#: engine/lua/match3.lua
msgid "Amazing!"
msgstr "すごい！"

#: engine/lua/match3.lua
msgid "Bonus collected."
msgstr "ボーナスを獲得しました。"

#: engine/lua/match3.lua
msgid "Choose a piece to clear its axes."
msgstr "ピースを選ぶと、縦と横の列を消します。"

#: engine/lua/match3.lua
msgid "Choose a piece to remove."
msgstr "消したいピースを選んでください。"

#: engine/lua/match3.lua
msgid "Choose the centre of a blast."
msgstr "爆発の中心を選んでください。"

#: engine/lua/match3.lua
msgid "Connect matching resources."
msgstr "同じ資源をそろえよう。"

#: engine/lua/match3.lua
msgid "Great!"
msgstr "グレート！"

#: engine/lua/match3.lua
msgid "Ice and chains must be broken first."
msgstr "先に氷と鎖を壊さなければなりません。"

#: engine/lua/match3.lua
msgid "MOVES"
msgstr "手数"

#: engine/lua/match3.lua
msgid "Match its pieces to charge this tool."
msgstr "このツールのピースをそろえるとチャージされます。"

#: engine/lua/match3.lua
msgid "More moves added."
msgstr "手数が増えました。"

#: engine/lua/match3.lua
msgid "Nice!"
msgstr "ナイス！"

#: engine/lua/match3.lua
msgid "No charges left. More tools next expedition."
msgstr "チャージがありません。次の探検でまたツールが使えます。"

#: engine/lua/match3.lua
msgid "No moves. Board reshuffled."
msgstr "動かせません。盤面をシャッフルしました。"

#: engine/lua/match3.lua
msgid "No shuffle available."
msgstr "シャッフルは使えません。"

#: engine/lua/match3.lua
msgid "Nothing to do."
msgstr "できることがありません。"

#: engine/lua/match3.lua
msgid "PRIVACY POLICY"
msgstr "プライバシーポリシー"

#: engine/lua/match3.lua
msgid "Pieces reshuffled."
msgstr "ピースをシャッフルしました。"

#: engine/lua/match3.lua
msgid "REDUCE MOTION"
msgstr "視差効果を減らす"

#: engine/lua/match3.lua engine/lua/match3/game.lua
msgid "RESTART"
msgstr "やり直す"

#: engine/lua/match3.lua
msgid "RESUME"
msgstr "再開"

#: engine/lua/match3.lua
msgid "Resources"
msgstr "資源"

#: engine/lua/match3.lua
msgid "Restore its building to unlock this tool."
msgstr "建物を修復すると、このツールが使えます。"

#: engine/lua/match3.lua
msgid "SOUND"
msgstr "サウンド"

#: engine/lua/match3.lua
msgid "STORY"
msgstr "ストーリー"

#: engine/lua/match3.lua
msgid "Settings"
msgstr "設定"

#: engine/lua/match3.lua
msgid "Spectacular!"
msgstr "スペクタクル！"

#: engine/lua/match3.lua
msgid "TOOLS DO NOT COST MOVES. TAP ONE, THEN A TILE."
msgstr "ツールは手数を使いません。ツールをタップして、マスを選んでください。"

#: engine/lua/match3.lua
msgid "Tool put away."
msgstr "ツールをしまいました。"

#: engine/lua/match3.lua
msgid "Your other bonuses are already charged."
msgstr "ほかのボーナスはすでにチャージ済みです。"

#: engine/lua/match3.lua
msgid "Your other bonuses gained charge."
msgstr "ほかのボーナスもチャージされました。"

#: engine/lua/match3/bonuses.lua
msgid "Add five moves."
msgstr "手数を5回増やします。"

#: engine/lua/match3/bonuses.lua
msgid "Bomb"
msgstr "ボム"

#: engine/lua/match3/bonuses.lua
msgid "Choose a resource piece for 100 resources or another bonus to add a quarter charge."
msgstr "資源のピースを選ぶと資源100、ほかのボーナスを選ぶと4分の1チャージ。"

#: engine/lua/match3/bonuses.lua
msgid "Clear all pieces of a chosen kind."
msgstr "選んだ種類のピースをすべて消します。"

#: engine/lua/match3/bonuses.lua
msgid "Hammer"
msgstr "ハンマー"

#: engine/lua/match3/bonuses.lua
msgid "Hit a 3×3 square around a cell."
msgstr "マスの周囲3×3を叩きます。"

#: engine/lua/match3/bonuses.lua
msgid "Hit one cell."
msgstr "1マスを叩きます。"

#: engine/lua/match3/bonuses.lua
msgid "Hit the row through a chosen cell."
msgstr "選んだマスの行を叩きます。"

#: engine/lua/match3/bonuses.lua
msgid "Hourglass"
msgstr "砂時計"

#: engine/lua/match3/bonuses.lua
msgid "Lightning"
msgstr "稲妻"

#: engine/lua/match3/bonuses.lua
msgid "Mixer"
msgstr "ミキサー"

#: engine/lua/match3/bonuses.lua
msgid "Plus"
msgstr "プラス"

#: engine/lua/match3/bonuses.lua
msgid "Shield"
msgstr "シールド"

#: engine/lua/match3/bonuses.lua
msgid "Shuffle the pieces."
msgstr "ピースをシャッフルします。"

#: engine/lua/match3/bonuses.lua
msgid "Star"
msgstr "スター"

#: engine/lua/match3/bonuses.lua
msgid "Strike up to fifteen random cells."
msgstr "ランダムな最大15マスを打ちます。"

#: engine/lua/match3/game.lua
msgid "A NEW PLACE TO DISCOVER"
msgstr "新しい場所を発見しよう"

#: engine/lua/match3/game.lua
msgid "BACK"
msgstr "戻る"

#: engine/lua/match3/game.lua
msgid "BUILD"
msgstr "建設"

#: engine/lua/match3/game.lua
msgid "Build your town"
msgstr "町をつくろう"

#: engine/lua/match3/game.lua
msgid "Building details"
msgstr "建物の詳細"

#: engine/lua/match3/game.lua
msgid "Building funded! Spare gold is yours to decorate."
msgstr "建設資金がそろいました！余ったゴールドは飾りつけに使えます。"

#: engine/lua/match3/game.lua
msgid "CLEAR NEW LEVELS TO OPEN IT"
msgstr "新しいレベルをクリアして開放"

#: engine/lua/match3/game.lua
msgid "CONTINUE"
msgstr "続ける"

#: engine/lua/match3/game.lua
msgid "DECORATION BONUS"
msgstr "飾りボーナス"

#: engine/lua/match3/game.lua
msgid "Decorations"
msgstr "飾り"

#: engine/lua/match3/game.lua
msgid "EARN RESOURCES"
msgstr "資源を集めよう"

#: engine/lua/match3/game.lua engine/lua/match3/user_events.lua
msgid "EVERY WIN"
msgstr "勝つたび"

#: engine/lua/match3/game.lua
msgid "FINISH THE PREVIOUS PROJECTS"
msgstr "前の計画を完成させよう"

#: engine/lua/match3/game.lua
msgid "GUIDE"
msgstr "ガイド"

#: engine/lua/match3/game.lua
msgid "Gold buys buildings."
msgstr "ゴールドで建物を買えます。"

#: engine/lua/match3/game.lua
msgid "KEEP PLAYING"
msgstr "続けてプレイ"

#: engine/lua/match3/game.lua
msgid "LEADERBOARD"
msgstr "ランキング"

#: engine/lua/match3/game.lua
#, lua-format
