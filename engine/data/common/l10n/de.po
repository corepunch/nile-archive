#. TRANSLATORS: %s is a tool's name (Hammer, Bomb ...): its pieces charge it
#: engine/lua/match3/tutorial.lua
#, lua-format
msgid "Match %s pieces to charge the tool."
msgstr "Kombiniere %s-Steine, um das Werkzeug zu laden."

#: engine/lua/match3/tutorial.lua
msgid "Match five in a line to make a Rainbow Gem."
msgstr "Kombiniere fünf in einer Reihe, um einen Regenbogenstein zu erschaffen."

#: engine/lua/match3/tutorial.lua
msgid "Match four in a line to make a Line Gem."
msgstr "Kombiniere vier in einer Reihe, um einen Linienstein zu erschaffen."

#: engine/lua/match3/tutorial.lua
msgid "Match the Line Gem with pieces of its kind to clear a whole line."
msgstr "Kombiniere den Linienstein mit Steinen seiner Sorte, um eine ganze Linie zu räumen."

#: engine/lua/match3/tutorial.lua
msgid "Skip"
msgstr "Überspringen"

#: engine/lua/match3/tutorial.lua
msgid "Swap the Rainbow Gem with a piece to clear every piece of that kind."
msgstr "Tausche den Regenbogenstein mit einem Stein, um alle Steine dieser Sorte zu räumen."

#: engine/lua/match3/tutorial.lua
msgid "Swap the highlighted pieces to match three in a line."
msgstr "Tausche die markierten Steine, um drei in einer Reihe zu bekommen."

#. TRANSLATORS: a tool's name, then the sentence saying what it does
#: engine/lua/match3/tutorial.lua
#, lua-format
msgid "Tap %s. %s"
msgstr "%s antippen. %s"

#: engine/lua/match3/user_events.lua
msgid "FEAT"
msgstr "LEISTUNG"

#: engine/lua/match3/user_events.lua
msgid "TOOL"
msgstr "WERKZEUG"

#. TRANSLATORS: %s is a tool's name (Hammer, Bomb ...)
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "The %s charges faster."
msgstr "%s lädt sich schneller auf."

#. TRANSLATORS: the upgrade ("a second saw bench"), a resource name (Food); the amount is shown beside it
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you bank this much %s in one level."
msgstr "Upgrade: %s, wenn du so viel %s in einem Level sammelst."

#. TRANSLATORS: the upgrade ("a second saw bench"), a count, then the shortest line that counts
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make %d matches of %d or more in one level."
msgstr "Upgrade: %s, wenn du in einem Level %d Kombinationen mit mindestens %d Steinen schaffst."

#. TRANSLATORS: the upgrade ("a second saw bench"), a count of matches, then of seconds
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make %d matches within %d seconds."
msgstr "Upgrade: %s, wenn du %d Kombinationen in %d Sekunden schaffst."

#. TRANSLATORS: the upgrade ("a second saw bench"), a count, the goal tile's name (plaque)
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make %d moves in a row that each clear a %s."
msgstr "Upgrade: %s, wenn du %d Züge hintereinander machst, die jeweils eine %s räumen."

#. TRANSLATORS: the upgrade ("a second saw bench"), the shortest line that counts, a count
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make a match of %d or more in %d moves in a row."
msgstr "Upgrade: %s, wenn du in %d Zügen hintereinander jeweils mindestens %d Steine kombinierst."

#. TRANSLATORS: the upgrade ("a second saw bench"), then the shortest line that counts
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make a match of %d or more."
msgstr "Upgrade: %s, wenn du mindestens %d Steine kombinierst."

#. TRANSLATORS: %s is the upgrade ("a second saw bench"); "their" is the building's keeper
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you meet their feat."
msgstr "Upgrade: %s, wenn du ihre Leistung erreichst."

#. TRANSLATORS: the upgrade ("a second saw bench"), then a count of levels
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you win %d levels in a row without a failed one."
msgstr "Upgrade: %s, wenn du %d Level hintereinander ohne Niederlage gewinnst."

#. TRANSLATORS: %s is the upgrade ("a second saw bench")
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgraded: %s."
msgstr "Verbessert: %s."

#. TRANSLATORS: a board goal tile, in the form the sentence "... each clear a %s" needs
#: engine/lua/match3/user_events.lua
msgid "plaque"
msgstr "Plakette"

#: engine/lua/town/screen.lua
msgid "Choose open ground clear of other buildings."
msgstr "Wähle freien Boden ohne andere Gebäude."

#: engine/lua/town/screen.lua
msgid "Confirm to restore this building at its original site."
msgstr "Bestätige, um dieses Gebäude an seinem ursprünglichen Ort zu restaurieren."

#: engine/lua/town/screen.lua
msgid "Drag the building to choose a spot, or scroll the land."
msgstr "Ziehe das Gebäude an einen Platz oder verschiebe die Ansicht."

#: engine/lua/town/screen.lua
msgid "Not enough to build this yet."
msgstr "Noch nicht genug, um das zu bauen."

#: engine/lua/town/screen.lua
msgid "Nothing changed."
msgstr "Nichts hat sich geändert."

#: engine/lua/town/screen.lua
msgid "Open more land before placing this building."
msgstr "Öffne mehr Land, bevor du dieses Gebäude platzierst."

#: engine/lua/town/screen.lua
msgid "This building is not available yet."
msgstr "Dieses Gebäude ist noch nicht verfügbar."
