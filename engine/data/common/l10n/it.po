msgstr "GIOCA"

#: engine/lua/match3/game.lua
msgid "PRICE"
msgstr "PREZZO"

#: engine/lua/match3/game.lua
msgid "Projects"
msgstr "Progetti"

#: engine/lua/match3/game.lua
msgid "QUIT"
msgstr "ESCI"

#: engine/lua/match3/game.lua
msgid "RESOURCES"
msgstr "RISORSE"

#: engine/lua/match3/game.lua
msgid "RESTORE"
msgstr "RIPRISTINA"

#: engine/lua/match3/game.lua
msgid "Ready to build!"
msgstr "Pronto a costruire!"

#: engine/lua/match3/game.lua
msgid "Region"
msgstr "Regione"

#: engine/lua/match3/game.lua
msgid "Replay gold collected. Choose something in the shop."
msgstr "Oro della rigiocata raccolto. Scegli qualcosa nel negozio."

#: engine/lua/match3/game.lua
msgid "Restart this level?"
msgstr "Ricominciare questo livello?"

#: engine/lua/match3/game.lua
msgid "Results"
msgstr "Risultati"

#: engine/lua/match3/game.lua
msgid "SCORE"
msgstr "PUNTI"

#: engine/lua/match3/game.lua
msgid "SETTINGS"
msgstr "IMPOSTAZIONI"

#: engine/lua/match3/game.lua
msgid "SHOP"
msgstr "NEGOZIO"

#: engine/lua/match3/game.lua
msgid "SKIP"
msgstr "SALTA"

#: engine/lua/match3/game.lua
msgid "STILL MISSING"
msgstr "MANCANO"

#: engine/lua/match3/game.lua
msgid "Some buildings need a new spot. Hold one to move it."
msgstr "Alcuni edifici hanno bisogno di un nuovo posto. Tieni premuto per spostarne uno."

#: engine/lua/match3/game.lua
msgid "TRY AGAIN"
msgstr "RIPROVA"

#: engine/lua/match3/game.lua
msgid "The whole town is open."
msgstr "L'intera città è aperta."

#: engine/lua/match3/game.lua
msgid "To be continued"
msgstr "Continua..."

#. TRANSLATORS: %s is an epoch's name
#: engine/lua/match3/game.lua
#, lua-format
msgid "Unlocked in %s"
msgstr "Sbloccato in %s"

#: engine/lua/match3/game.lua
msgid "VISIT TOWN"
msgstr "VISITA LA CITTÀ"

#. TRANSLATORS: %d is the campaign's number of levels, always 100
#: engine/lua/match3/game.lua
#, lua-format
msgid "YOU COMPLETED ALL %d LEVELS."
msgstr "HAI COMPLETATO TUTTI I %d LIVELLI."

#: engine/lua/match3/game.lua
msgid "YOU GET"
msgstr "OTTIENI"

#: engine/lua/match3/game.lua
msgid "You won!"
msgstr "Hai vinto!"

#: engine/lua/match3/game.lua
msgid "Your board is saved. Open its project to earn more resources."
msgstr "La tua partita è salvata. Apri il suo progetto per guadagnare altre risorse."

#: engine/lua/match3/game.lua
#, lua-format
msgid "Your board is saved. Tap Play to continue level %d."
msgstr "La tua partita è salvata. Tocca Gioca per continuare il livello %d."

#: engine/lua/match3/game.lua
msgid "Your town stays open to build."
msgstr "La tua città resta aperta per costruire."

#: engine/lua/match3/tutorial.lua
msgid "Clear the targets before you run out of moves. Swap these pieces to match three in a line."
msgstr "Elimina gli obiettivi prima di finire le mosse. Scambia queste tessere per allinearne tre."

#. TRANSLATORS: %s is a tool's name (Hammer, Bomb ...): its pieces charge it
#: engine/lua/match3/tutorial.lua
#, lua-format
msgid "Match %s pieces to charge the tool."
msgstr "Abbina i pezzi %s per caricare lo strumento."

#: engine/lua/match3/tutorial.lua
msgid "Match five in a line to make a Rainbow Gem."
msgstr "Abbina cinque in linea per ottenere una Gemma Arcobaleno."

#: engine/lua/match3/tutorial.lua
msgid "Match four in a line to make a Line Gem."
msgstr "Abbina quattro in linea per ottenere una Gemma Linea."

#: engine/lua/match3/tutorial.lua
msgid "Match the Line Gem with pieces of its kind to clear a whole line."
msgstr "Abbina la Gemma Linea a pezzi dello stesso tipo per liberare un'intera linea."

#: engine/lua/match3/tutorial.lua
msgid "Skip"
msgstr "Salta"

#: engine/lua/match3/tutorial.lua
msgid "Swap the Rainbow Gem with a piece to clear every piece of that kind."
msgstr "Scambia la Gemma Arcobaleno con un pezzo per eliminare tutti i pezzi di quel tipo."

#. TRANSLATORS: a tool's name, then the sentence saying what it does
#: engine/lua/match3/tutorial.lua
#, lua-format
msgid "Tap %s. %s"
msgstr "Tocca %s. %s"

#: engine/lua/match3/user_events.lua
msgid "FEAT"
msgstr "IMPRESA"

#: engine/lua/match3/user_events.lua
msgid "TOOL"
msgstr "STRUMENTO"

#. TRANSLATORS: %s is a tool's name (Hammer, Bomb ...)
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "The %s charges faster."
msgstr "%s si carica più in fretta."

#. TRANSLATORS: the upgrade ("a second saw bench"), a resource name (Food); the amount is shown beside it
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you bank this much %s in one level."
msgstr "Potenziamento: %s, quando accumuli tanto %s in un solo livello."

#. TRANSLATORS: the upgrade ("a second saw bench"), a count, then the shortest line that counts
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make %d matches of %d or more in one level."
msgstr "Potenziamento: %s, quando fai %d combinazioni di %d o più in un livello."

#. TRANSLATORS: the upgrade ("a second saw bench"), a count of matches, then of seconds
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make %d matches within %d seconds."
msgstr "Potenziamento: %s, quando fai %d combinazioni entro %d secondi."

#. TRANSLATORS: the upgrade ("a second saw bench"), a count, the goal tile's name (plaque)
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make %d moves in a row that each clear a %s."
msgstr "Potenziamento: %s, quando fai %d mosse di fila che liberano ciascuna una %s."

#. TRANSLATORS: the upgrade ("a second saw bench"), the shortest line that counts, a count
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make a match of %d or more in %d moves in a row."
msgstr "Potenziamento: %s, quando fai una combinazione di %d o più in %d mosse di fila."

#. TRANSLATORS: the upgrade ("a second saw bench"), then the shortest line that counts
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you make a match of %d or more."
msgstr "Potenziamento: %s, quando fai una combinazione di %d o più."

#. TRANSLATORS: %s is the upgrade ("a second saw bench"); "their" is the building's keeper
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you meet their feat."
msgstr "Potenziamento: %s, quando raggiungi la sua impresa."

#. TRANSLATORS: the upgrade ("a second saw bench"), then a count of levels
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgrade: %s, when you win %d levels in a row without a failed one."
msgstr "Potenziamento: %s, quando vinci %d livelli di fila senza sconfitte."

#. TRANSLATORS: %s is the upgrade ("a second saw bench")
#: engine/lua/match3/user_events.lua
#, lua-format
msgid "Upgraded: %s."
msgstr "Potenziato: %s."

#. TRANSLATORS: a board goal tile, in the form the sentence "... each clear a %s" needs
#: engine/lua/match3/user_events.lua
msgid "plaque"
msgstr "targa"

#: engine/lua/town/screen.lua
msgid "Choose open ground clear of other buildings."
msgstr "Scegli un terreno libero, lontano dagli altri edifici."

#: engine/lua/town/screen.lua
msgid "Confirm to restore this building at its original site."
msgstr "Conferma per ripristinare questo edificio nel suo sito originale."

#: engine/lua/town/screen.lua
msgid "Drag the building to choose a spot, or scroll the land."
msgstr "Trascina l'edificio per scegliere un posto, o scorri il terreno."

#: engine/lua/town/screen.lua
msgid "Not enough to build this yet."
msgstr "Non basta ancora per costruirlo."

#: engine/lua/town/screen.lua
msgid "Nothing changed."
msgstr "Non è cambiato nulla."

#: engine/lua/town/screen.lua
msgid "Open more land before placing this building."
msgstr "Apri altro terreno prima di sistemare questo edificio."

#: engine/lua/town/screen.lua
msgid "This building is not available yet."
msgstr "Questo edificio non è ancora disponibile."
