#. TRANSLATORS: follows the player's own name in the leaderboard
#: engine/lua/leaderboard.lua
msgid "(you)"
msgstr "(tu)"

#: engine/lua/leaderboard.lua
msgid "Close"
msgstr "Chiudi"

#: engine/lua/leaderboard.lua
msgid "Everyone"
msgstr "Tutti"

#: engine/lua/leaderboard.lua
msgid "Friends"
msgstr "Amici"

#: engine/lua/leaderboard.lua
msgid "Leaderboard"
msgstr "Classifica"

#: engine/lua/leaderboard.lua
msgid "Loading..."
msgstr "Caricamento..."

#: engine/lua/leaderboard.lua
msgid "No scores yet. Be the first!"
msgstr "Ancora nessun punteggio. Sii il primo!"

#: engine/lua/leaderboard.lua
msgid "None of your friends have played yet."
msgstr "Nessuno dei tuoi amici ha ancora giocato."

#: engine/lua/leaderboard.lua
msgid "Sign in to Game Center to compare with other players."
msgstr "Accedi a Game Center per confrontarti con altri giocatori."

#: engine/lua/leaderboard.lua
msgid "Sign in to Game Center to see your friends."
msgstr "Accedi a Game Center per vedere i tuoi amici."

#: engine/lua/match3.lua
msgid "Amazing!"
msgstr "Fantastico!"

#: engine/lua/match3.lua
msgid "Bonus collected."
msgstr "Bonus raccolto."

#: engine/lua/match3.lua
msgid "Choose a piece to clear its axes."
msgstr "Scegli un pezzo per liberare le sue linee."

#: engine/lua/match3.lua
msgid "Choose a piece to remove."
msgstr "Scegli un pezzo da rimuovere."

#: engine/lua/match3.lua
msgid "Choose the centre of a blast."
msgstr "Scegli il centro dell'esplosione."

#: engine/lua/match3.lua
msgid "Connect matching resources."
msgstr "Collega le risorse uguali."

#: engine/lua/match3.lua
msgid "Great!"
msgstr "Grande!"

