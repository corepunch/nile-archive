msgstr "COMPLETA PRIMA I PROGETTI PRECEDENTI"

#: engine/lua/match3/game.lua
msgid "GUIDE"
msgstr "GUIDA"

#: engine/lua/match3/game.lua
msgid "Gold buys buildings."
msgstr "L'oro compra gli edifici."

#: engine/lua/match3/game.lua
msgid "KEEP PLAYING"
msgstr "CONTINUA A GIOCARE"

#: engine/lua/match3/game.lua
msgid "LEADERBOARD"
msgstr "CLASSIFICA"

#: engine/lua/match3/game.lua
#, lua-format
msgid "LEVELS CLEARED  %d / %d"
msgstr "LIVELLI SUPERATI  %d / %d"

#: engine/lua/match3/game.lua
