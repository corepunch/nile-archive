msgid "SOUND"
msgstr "SUONO"

#: engine/lua/match3.lua
msgid "STORY"
msgstr "STORIA"

#: engine/lua/match3.lua
msgid "Settings"
msgstr "Impostazioni"

#: engine/lua/match3.lua
msgid "Spectacular!"
msgstr "Spettacolare!"

#: engine/lua/match3.lua
msgid "TOOLS DO NOT COST MOVES. TAP ONE, THEN A TILE."
msgstr "GLI STRUMENTI NON COSTANO MOSSE. TOCCANE UNO, POI UNA TESSERA."

#: engine/lua/match3.lua
msgid "Tool put away."
msgstr "Strumento riposto."

#: engine/lua/match3.lua
msgid "Your other bonuses are already charged."
msgstr "Gli altri bonus sono già carichi."

#: engine/lua/match3.lua
msgid "Your other bonuses gained charge."
msgstr "Gli altri bonus si sono caricati."

#: engine/lua/match3/bonuses.lua
msgid "Add five moves."
msgstr "Aggiungi cinque mosse."

#: engine/lua/match3/bonuses.lua
msgid "Bomb"
msgstr "Bomba"

#: engine/lua/match3/bonuses.lua
msgid "Choose a resource piece for 100 resources or another bonus to add a quarter charge."
msgstr "Scegli un pezzo risorsa per 100 risorse o un altro bonus per aggiungere un quarto di carica."

#: engine/lua/match3/bonuses.lua
msgid "Clear all pieces of a chosen kind."
msgstr "Elimina tutti i pezzi di un tipo a scelta."

#: engine/lua/match3/bonuses.lua
msgid "Hammer"
msgstr "Martello"

#: engine/lua/match3/bonuses.lua
msgid "Hit a 3×3 square around a cell."
msgstr "Colpisci un quadrato 3×3 attorno a una cella."

#: engine/lua/match3/bonuses.lua
msgid "Hit one cell."
msgstr "Colpisci una cella."

#: engine/lua/match3/bonuses.lua
msgid "Hit the row through a chosen cell."
msgstr "Colpisci la riga che passa per una cella a scelta."

#: engine/lua/match3/bonuses.lua
msgid "Hourglass"
msgstr "Clessidra"

#: engine/lua/match3/bonuses.lua
msgid "Lightning"
msgstr "Fulmine"

#: engine/lua/match3/bonuses.lua
msgid "Mixer"
msgstr "Mixer"

#: engine/lua/match3/bonuses.lua
msgid "Plus"
msgstr "Più"

#: engine/lua/match3/bonuses.lua
msgid "Shield"
msgstr "Scudo"

#: engine/lua/match3/bonuses.lua
msgid "Shuffle the pieces."
msgstr "Rimescola i pezzi."

#: engine/lua/match3/bonuses.lua
msgid "Star"
msgstr "Stella"

#: engine/lua/match3/bonuses.lua
msgid "Strike up to fifteen random cells."
msgstr "Colpisci fino a quindici celle a caso."

#: engine/lua/match3/game.lua
msgid "A NEW PLACE TO DISCOVER"
msgstr "UN NUOVO POSTO DA SCOPRIRE"

#: engine/lua/match3/game.lua
msgid "BACK"
msgstr "INDIETRO"

#: engine/lua/match3/game.lua
msgid "BUILD"
msgstr "COSTRUISCI"

#: engine/lua/match3/game.lua
msgid "Build your town"
msgstr "Costruisci la tua città"

#: engine/lua/match3/game.lua
msgid "Building details"
msgstr "Dettagli dell'edificio"

#: engine/lua/match3/game.lua
msgid "Building funded! Spare gold is yours to decorate."
msgstr "Edificio finanziato! L'oro che avanza è tuo, per decorare."

#: engine/lua/match3/game.lua
msgid "CLEAR NEW LEVELS TO OPEN IT"
msgstr "SUPERA NUOVI LIVELLI PER APRIRLO"

#: engine/lua/match3/game.lua
msgid "CONTINUE"
msgstr "CONTINUA"

