msgid "Ice and chains must be broken first."
msgstr "Prima devi rompere ghiaccio e catene."

#: engine/lua/match3.lua
msgid "MOVES"
msgstr "MOSSE"

#: engine/lua/match3.lua
msgid "Match its pieces to charge this tool."
msgstr "Abbina i suoi pezzi per caricare questo strumento."

#: engine/lua/match3.lua
msgid "More moves added."
msgstr "Mosse aggiunte."

#: engine/lua/match3.lua
msgid "Nice!"
msgstr "Bene!"

