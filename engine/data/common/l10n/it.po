msgid "No charges left. More tools next expedition."
msgstr "Nessuna carica rimasta. Altri strumenti alla prossima spedizione."

#: engine/lua/match3.lua
msgid "No moves. Board reshuffled."
msgstr "Nessuna mossa. Tavola rimescolata."

#: engine/lua/match3.lua
msgid "No shuffle available."
msgstr "Nessun rimescolamento disponibile."

#: engine/lua/match3.lua
msgid "Nothing to do."
msgstr "Niente da fare."

#: engine/lua/match3.lua
msgid "PRIVACY POLICY"
msgstr "INFORMATIVA SULLA PRIVACY"

#: engine/lua/match3.lua
msgid "Pieces reshuffled."
msgstr "Pezzi rimescolati."

#: engine/lua/match3.lua
msgid "RATE THE GAME"
msgstr "VALUTA IL GIOCO"

#: engine/lua/match3.lua
msgid "REDUCE MOTION"
msgstr "RIDUCI MOVIMENTO"

#: engine/lua/match3.lua engine/lua/match3/game.lua
msgid "RESTART"
msgstr "RICOMINCIA"

#: engine/lua/match3.lua
msgid "RESUME"
msgstr "RIPRENDI"

#: engine/lua/match3.lua
msgid "Resources"
msgstr "Risorse"

#: engine/lua/match3.lua
