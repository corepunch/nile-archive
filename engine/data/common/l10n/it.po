msgstr "MENU PRINCIPALE"

#: engine/lua/match3/game.lua
msgid "MORE GOLD NEEDED"
msgstr "SERVE ALTRO ORO"

#: engine/lua/match3/game.lua
msgid "MOVE"
msgstr "MOSSA"

#: engine/lua/match3/game.lua
msgid "Match-3 town"
msgstr "Città match-3"

#: engine/lua/match3/game.lua
msgid "OPEN THIS AREA"
msgstr "APRI QUESTA ZONA"

#. TRANSLATORS: %s is an epoch's name
#: engine/lua/match3/game.lua
#, lua-format
msgid "OPENS IN %s"
msgstr "SI APRE IN %s"

#: engine/lua/match3/game.lua
