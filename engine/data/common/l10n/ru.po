msgstr "Войди в Game Center, чтобы увидеть друзей."

#: engine/lua/match3.lua
msgid "Amazing!"
msgstr "Потрясающе!"

#: engine/lua/match3.lua
msgid "Bonus collected."
msgstr "Бонус собран."

#: engine/lua/match3.lua
msgid "Choose a piece to clear its axes."
msgstr "Выбери фишку, чтобы очистить её ряд и столбец."

#: engine/lua/match3.lua
msgid "Choose a piece to remove."
msgstr "Выбери фишку, чтобы убрать её."

#: engine/lua/match3.lua
msgid "Choose the centre of a blast."
msgstr "Выбери центр взрыва."

#: engine/lua/match3.lua
msgid "Connect matching resources."
msgstr "Соединяй одинаковые ресурсы."

#: engine/lua/match3.lua
msgid "Great!"
msgstr "Отлично!"

