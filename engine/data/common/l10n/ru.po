#: engine/lua/match3.lua
msgid "Tool put away."
msgstr "Инструмент убран."

#: engine/lua/match3.lua
msgid "Your other bonuses are already charged."
msgstr "Остальные бонусы уже заряжены."

#: engine/lua/match3.lua
msgid "Your other bonuses gained charge."
msgstr "Остальные бонусы получили заряд."

#: engine/lua/match3/bonuses.lua
msgid "Add five moves."
msgstr "Добавляет пять ходов."

#: engine/lua/match3/bonuses.lua
msgid "Bomb"
msgstr "Бомба"

#: engine/lua/match3/bonuses.lua
msgid "Choose a resource piece for 100 resources or another bonus to add a quarter charge."
msgstr "Выбери фишку ресурса, чтобы получить 100 ресурсов, или другой бонус, чтобы добавить четверть заряда."

#: engine/lua/match3/bonuses.lua
msgid "Clear all pieces of a chosen kind."
msgstr "Убирает все фишки выбранного вида."

#: engine/lua/match3/bonuses.lua
msgid "Hammer"
msgstr "Молоток"

#: engine/lua/match3/bonuses.lua
msgid "Hit a 3×3 square around a cell."
msgstr "Бьёт по квадрату 3×3 вокруг клетки."

#: engine/lua/match3/bonuses.lua
msgid "Hit one cell."
msgstr "Бьёт по одной клетке."

#: engine/lua/match3/bonuses.lua
msgid "Hit the row through a chosen cell."
msgstr "Бьёт по ряду через выбранную клетку."

#: engine/lua/match3/bonuses.lua
