msgid "No moves. Board reshuffled."
msgstr "Ходов нет. Поле перемешано."

#: engine/lua/match3.lua
msgid "No shuffle available."
msgstr "Перемешивание недоступно."

#: engine/lua/match3.lua
msgid "Nothing to do."
msgstr "Здесь нечего делать."

