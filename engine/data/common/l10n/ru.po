msgid "Ice and chains must be broken first."
msgstr "Сначала нужно разбить лёд и цепи."

#: engine/lua/match3.lua
msgid "MOVES"
msgstr "ХОДЫ"

#: engine/lua/match3.lua
msgid "Match its pieces to charge this tool."
msgstr "Собирай её фишки, чтобы зарядить инструмент."

#: engine/lua/match3.lua
msgid "More moves added."
msgstr "Ходов прибавилось."

#: engine/lua/match3.lua
msgid "Nice!"
msgstr "Здорово!"

#: engine/lua/match3.lua
msgid "No charges left. More tools next expedition."
msgstr "Зарядов не осталось. Новые инструменты будут в следующей экспедиции."

