msgstr "ЧП  /  %02d"

#: games/emergency/lua/main.lua
msgid "Emergency - After the Eruption"
msgstr "ЧП — после извержения"

#: games/emergency/lua/main.lua
msgid "Every route matters"
msgstr "Важен каждый путь"

#: games/emergency/lua/main.lua
msgid "Five districts. One rescue team. A fresh start."
msgstr "Пять районов. Одна спасательная команда. Новое начало."

#: games/emergency/lua/main.lua
msgid "Food"
msgstr "Еда"

#: games/emergency/lua/main.lua
msgid "Hint"
msgstr "Подсказка"

#: games/emergency/lua/main.lua
