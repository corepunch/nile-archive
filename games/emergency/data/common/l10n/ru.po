#: games/emergency/lua/emergency_sim.lua
msgid "A worker is on the way."
msgstr "Рабочий уже в пути."

#: games/emergency/lua/emergency_sim.lua
msgid "Clear ash and rubble"
msgstr "Убрать пепел и щебень"

#: games/emergency/lua/emergency_sim.lua
msgid "Clear heavy basalt"
msgstr "Убрать тяжёлый базальт"

#: games/emergency/lua/emergency_sim.lua
msgid "Dismantle collapsed wall"
msgstr "Разобрать обрушенную стену"

#: games/emergency/lua/emergency_sim.lua
msgid "District office"
msgstr "Районная контора"

#: games/emergency/lua/emergency_sim.lua
msgid "Field kitchen"
msgstr "Полевая кухня"

#: games/emergency/lua/emergency_sim.lua
msgid "Queued - tap to cancel"
msgstr "В очереди — нажмите, чтобы отменить"

#: games/emergency/lua/emergency_sim.lua
msgid "Repair the road"
msgstr "Починить дорогу"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue a cat"
msgstr "Спасти кошку"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue a dog"
msgstr "Спасти собаку"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue headquarters"
msgstr "Спасательный штаб"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue worker"
msgstr "Спасатель"

#: games/emergency/lua/emergency_sim.lua
msgid "Resident"
msgstr "Житель"

#: games/emergency/lua/emergency_sim.lua
msgid "Restored."
msgstr "Восстановлено."

#: games/emergency/lua/emergency_sim.lua
msgid "Returns to headquarters automatically once the route is safe."
msgstr "Как только путь станет безопасным, сам вернётся в штаб."

#: games/emergency/lua/emergency_sim.lua
msgid "Salvage roof beams"
msgstr "Снять балки с крыши"

#: games/emergency/lua/emergency_sim.lua
msgid "Supplies arrive automatically every 5 seconds."
msgstr "Припасы поступают сами каждые 5 секунд."

#: games/emergency/lua/emergency_sim.lua
msgid "Tap a job to send a worker. Tap again to cancel a queued job."
msgstr "Нажмите на задание, чтобы отправить рабочего. Нажмите ещё раз, чтобы отменить задание в очереди."

#: games/emergency/lua/emergency_sim.lua
msgid "Tap to assign"
msgstr "Нажмите, чтобы назначить"

#: games/emergency/lua/emergency_sim.lua
msgid "Timber yard"
msgstr "Лесопилка"

