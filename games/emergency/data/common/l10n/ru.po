#: games/emergency/lua/main.lua
#, lua-format
msgid "All %s and %s are safe."
msgstr "В безопасности: %s и %s."

#: games/emergency/lua/main.lua
msgid "District restored!"
msgstr "Район восстановлен!"

#: games/emergency/lua/main.lua
msgid "Districts"
