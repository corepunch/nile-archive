#: games/emergency/lua/main.lua
msgid "District restored!"
msgstr "地区を復旧しました！"

#: games/emergency/lua/main.lua
msgid "Districts"
msgstr "地区"

#: games/emergency/lua/main.lua
msgid "EMERGENCY"
msgstr "エマージェンシー"

