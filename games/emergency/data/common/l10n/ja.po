#, lua-format
msgid "%d wood"
msgid_plural "%d wood"
msgstr[0] "木材%d"

#: games/emergency/lua/emergency_sim.lua
msgid "A worker is on the way."
msgstr "作業員が向かっています。"

#: games/emergency/lua/emergency_sim.lua
msgid "Clear ash and rubble"
msgstr "灰と瓦礫の撤去"

#: games/emergency/lua/emergency_sim.lua
msgid "Clear heavy basalt"
msgstr "重い玄武岩の撤去"

#: games/emergency/lua/emergency_sim.lua
msgid "Dismantle collapsed wall"
msgstr "崩れた壁の解体"

#: games/emergency/lua/emergency_sim.lua
msgid "District office"
msgstr "地区事務所"

#: games/emergency/lua/emergency_sim.lua
msgid "Field kitchen"
msgstr "炊き出し所"

#: games/emergency/lua/emergency_sim.lua
msgid "Queued - tap to cancel"
msgstr "順番待ち - タップで取消"

#: games/emergency/lua/emergency_sim.lua
msgid "Repair the road"
msgstr "道路の修理"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue a cat"
msgstr "ネコの救助"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue a dog"
msgstr "イヌの救助"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue headquarters"
msgstr "救助本部"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue worker"
msgstr "救助隊員"

#: games/emergency/lua/emergency_sim.lua
msgid "Resident"
msgstr "住民"

#: games/emergency/lua/emergency_sim.lua
msgid "Restored."
msgstr "復旧しました。"

#: games/emergency/lua/emergency_sim.lua
msgid "Returns to headquarters automatically once the route is safe."
msgstr "道が安全になると、自動で本部へ戻ります。"

#: games/emergency/lua/emergency_sim.lua
msgid "Salvage roof beams"
msgstr "屋根の梁の回収"

#: games/emergency/lua/emergency_sim.lua
msgid "Supplies arrive automatically every 5 seconds."
msgstr "物資は5秒ごとに自動で届きます。"

#: games/emergency/lua/emergency_sim.lua
msgid "Tap a job to send a worker. Tap again to cancel a queued job."
msgstr "作業をタップすると作業員を派遣します。順番待ちの作業は、もう一度タップで取り消せます。"

#: games/emergency/lua/emergency_sim.lua
msgid "Tap to assign"
msgstr "タップして割り当て"

#: games/emergency/lua/emergency_sim.lua
msgid "Timber yard"
msgstr "製材所"

