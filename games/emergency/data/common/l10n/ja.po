#: games/emergency/lua/main.lua
#, lua-format
msgid "EMERGENCY  /  %02d"
msgstr "エマージェンシー  /  %02d"

#: games/emergency/lua/main.lua
msgid "Emergency - After the Eruption"
msgstr "エマージェンシー - 噴火のあとで"

#: games/emergency/lua/main.lua
msgid "Every route matters"
msgstr "どの道も大切"

#: games/emergency/lua/main.lua
msgid "Five districts. One rescue team. A fresh start."
msgstr "五つの地区。ひとつの救助隊。新たな出発。"

#: games/emergency/lua/main.lua
msgid "Food"
msgstr "食料"

#: games/emergency/lua/main.lua
msgid "Hint"
msgstr "ヒント"

#: games/emergency/lua/main.lua
msgid "How to play"
msgstr "遊び方"

#: games/emergency/lua/main.lua
msgid "Leaderboard"
msgstr "ランキング"

#: games/emergency/lua/main.lua
msgid "Let the team finish its jobs and the stations deliver supplies."
msgstr "隊員が作業を終え、施設から物資が届くのを待ちましょう。"

#: games/emergency/lua/main.lua
msgid "Money"
msgstr "お金"

#: games/emergency/lua/main.lua
msgid "Next district"
msgstr "次の地区へ"

#: games/emergency/lua/main.lua
msgid "Pause"
msgstr "一時停止"

#: games/emergency/lua/main.lua
#, lua-format
msgid "People %d/%d   Pets %d/%d   Roads %d/%d"
msgstr "人 %d/%d   ペット %d/%d   道路 %d/%d"

#: games/emergency/lua/main.lua
msgid "Play the episode again"
msgstr "エピソードをもう一度"

#: games/emergency/lua/main.lua
msgid "Ready"
msgstr "準備完了"

#: games/emergency/lua/main.lua
msgid "Reopen the streets. Restore supplies. Bring everyone home."
msgstr "通りを開通させ、物資を復旧し、みんなを家に帰そう。"

#: games/emergency/lua/main.lua
msgid "Replay district"
msgstr "地区をもう一度"

#: games/emergency/lua/main.lua
msgid "Rescue dispatch"
msgstr "救助出動"

#: games/emergency/lua/main.lua
msgid "Rescue paused"
msgstr "救助を一時停止中"

#: games/emergency/lua/main.lua
msgid "Rescue score"
msgstr "救助スコア"

#: games/emergency/lua/main.lua
msgid "Restart district"
msgstr "地区をやり直す"

#: games/emergency/lua/main.lua
msgid "Restore the city, one route at a time"
msgstr "ひとつずつ道をつないで、街を取り戻そう"

#: games/emergency/lua/main.lua
msgid "Resume rescue"
msgstr "救助を再開"

#: games/emergency/lua/main.lua
msgid "START RESCUE"
msgstr "救助開始"

#: games/emergency/lua/main.lua
msgid "Sound"
msgstr "サウンド"

#: games/emergency/lua/main.lua
msgid ""
"Tap rubble, damaged roads or a station to assign a worker. Unavailable jobs join the queue; tap again to cancel.\n"
"\n"
"Kitchens, timber yards and offices produce supplies automatically. Residents and stranded workers return when their route is safe. Assign a worker to rescue pets.\n"
"\n"
"Drag to pan. Pinch or scroll to zoom. Restore every road and bring everyone home."
msgstr ""
"瓦礫、壊れた道路、施設をタップして作業員を割り当てます。すぐに着手できない作業は順番待ちになり、もう一度タップで取り消せます。\n"
"\n"
"炊き出し所、製材所、事務所は物資を自動で生み出します。住民や取り残された作業員は、道が安全になると戻ってきます。ペットの救助には作業員を割り当てましょう。\n"
"\n"
"ドラッグで移動、ピンチやスクロールで拡大縮小。すべての道を復旧して、みんなを家に帰そう。"

#: games/emergency/lua/main.lua
#, lua-format
msgid "WORKERS  %d / %d"
msgstr "作業員  %d / %d"

#: games/emergency/lua/main.lua
msgid "Wood"
msgstr "木材"

#: games/emergency/lua/main.lua
msgid "Your team and production are paused."
msgstr "チームと生産は一時停止中です。"
