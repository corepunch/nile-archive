#: games/emergency/lua/emergency_sim.lua
msgid "Salvage roof beams"
msgstr "Recuperar vigas del tejado"

#: games/emergency/lua/emergency_sim.lua
msgid "Supplies arrive automatically every 5 seconds."
msgstr "Los suministros llegan solos cada 5 segundos."

#: games/emergency/lua/emergency_sim.lua
msgid "Tap a job to send a worker. Tap again to cancel a queued job."
msgstr "Toca una tarea para enviar a un trabajador. Vuelve a tocarla para cancelarla si está en cola."

