#: games/emergency/lua/emergency_levels.lua
msgid "City Centre"
msgstr "Centro de la ciudad"

#: games/emergency/lua/emergency_levels.lua
msgid "City Centre: restore every evacuation route and bring the remaining residents and pets to headquarters."
msgstr "Centro de la ciudad: restablece todas las rutas de evacuación y lleva a los residentes y mascotas que quedan hasta el cuartel general."

#: games/emergency/lua/emergency_levels.lua
msgid "Cut-off District"
msgstr "Distrito aislado"

#: games/emergency/lua/emergency_levels.lua
msgid "Cut-off District: reopen the surviving roads around the cooled lava and reach each isolated group."
msgstr "Distrito aislado: reabre las carreteras que quedan en pie alrededor de la lava enfriada y llega hasta cada grupo aislado."

#: games/emergency/lua/emergency_levels.lua
msgid "Outskirts"
msgstr "Afueras"

#: games/emergency/lua/emergency_levels.lua
msgid "Outskirts: reopen the roads and reach four residents. Repair stations to restore automatic supplies."
msgstr "Afueras: reabre las carreteras y llega hasta cuatro residentes. Repara las estaciones para recuperar los suministros automáticos."

#: games/emergency/lua/emergency_levels.lua
msgid "Suburbs"
msgstr "Barrios periféricos"

#: games/emergency/lua/emergency_levels.lua
msgid "Suburbs: reconnect the homes and timber yard. Restore the office to fund heavy debris removal."
msgstr "Barrios periféricos: reconecta las casas y el aserradero. Restaura la oficina para financiar la retirada de escombros pesados."

#: games/emergency/lua/emergency_levels.lua
msgid "Town Square"
msgstr "Plaza Mayor"

#: games/emergency/lua/emergency_levels.lua
msgid "Town Square: reopen the inner streets and rescue the repair crew. Stations supply resources automatically."
msgstr "Plaza Mayor: reabre las calles interiores y rescata a la cuadrilla de reparación. Las estaciones suministran recursos automáticamente."

