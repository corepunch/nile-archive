#: games/emergency/lua/emergency_levels.lua
msgid "City Centre"
msgstr "Centro da Cidade"

#: games/emergency/lua/emergency_levels.lua
msgid "City Centre: restore every evacuation route and bring the remaining residents and pets to headquarters."
msgstr "Centro da Cidade: restaure todas as rotas de evacuação e leve os moradores e animais que restam até a central."

#: games/emergency/lua/emergency_levels.lua
msgid "Cut-off District"
msgstr "Distrito Isolado"

#: games/emergency/lua/emergency_levels.lua
msgid "Cut-off District: reopen the surviving roads around the cooled lava and reach each isolated group."
msgstr "Distrito Isolado: reabra as estradas que sobraram em volta da lava já fria e chegue a cada grupo isolado."

#: games/emergency/lua/emergency_levels.lua
msgid "Outskirts"
msgstr "Arredores"

#: games/emergency/lua/emergency_levels.lua
msgid "Outskirts: reopen the roads and reach four residents. Repair stations to restore automatic supplies."
msgstr "Arredores: reabra as estradas e chegue a quatro moradores. Conserte os postos para restabelecer o abastecimento automático."

#: games/emergency/lua/emergency_levels.lua
msgid "Suburbs"
msgstr "Subúrbios"

#: games/emergency/lua/emergency_levels.lua
msgid "Suburbs: reconnect the homes and timber yard. Restore the office to fund heavy debris removal."
msgstr "Subúrbios: religue as casas e a madeireira. Restaure o escritório para custear a remoção de entulho pesado."

#: games/emergency/lua/emergency_levels.lua
msgid "Town Square"
msgstr "Praça Central"

#: games/emergency/lua/emergency_levels.lua
msgid "Town Square: reopen the inner streets and rescue the repair crew. Stations supply resources automatically."
msgstr "Praça Central: reabra as ruas internas e resgate a equipe de reparos. Os postos fornecem recursos automaticamente."

