msgstr "Central de resgate"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue worker"
msgstr "Socorrista"

#: games/emergency/lua/emergency_sim.lua
msgid "Resident"
msgstr "Morador"

#: games/emergency/lua/emergency_sim.lua
msgid "Restored."
msgstr "Restaurado."

#: games/emergency/lua/emergency_sim.lua
msgid "Returns to headquarters automatically once the route is safe."
msgstr "Volta para a central sozinho assim que a rota estiver segura."

#: games/emergency/lua/emergency_sim.lua
msgid "Salvage roof beams"
msgstr "Recuperar vigas do telhado"

#: games/emergency/lua/emergency_sim.lua
msgid "Supplies arrive automatically every 5 seconds."
msgstr "Os suprimentos chegam sozinhos a cada 5 segundos."

#: games/emergency/lua/emergency_sim.lua
msgid "Tap a job to send a worker. Tap again to cancel a queued job."
msgstr "Toque em uma tarefa para enviar um trabalhador. Toque de novo para cancelar uma tarefa na fila."

