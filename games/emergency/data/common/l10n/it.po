#: games/emergency/lua/emergency_sim.lua
msgid "Queued - tap to cancel"
msgstr "In coda - tocca per annullare"

#: games/emergency/lua/emergency_sim.lua
msgid "Repair the road"
msgstr "Ripara la strada"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue a cat"
msgstr "Salva un gatto"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue a dog"
msgstr "Salva un cane"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue headquarters"
msgstr "Salva il quartier generale"

#: games/emergency/lua/emergency_sim.lua
msgid "Rescue worker"
msgstr "Salva l'operaio"

#: games/emergency/lua/emergency_sim.lua
msgid "Resident"
msgstr "Residente"

#: games/emergency/lua/emergency_sim.lua
msgid "Restored."
msgstr "Ripristinato."

#: games/emergency/lua/emergency_sim.lua
msgid "Returns to headquarters automatically once the route is safe."
msgstr "Torna al quartier generale da solo quando il percorso è sicuro."

#: games/emergency/lua/emergency_sim.lua
msgid "Salvage roof beams"
msgstr "Recupera le travi del tetto"

#: games/emergency/lua/emergency_sim.lua
msgid "Supplies arrive automatically every 5 seconds."
msgstr "I rifornimenti arrivano da soli ogni 5 secondi."

#: games/emergency/lua/emergency_sim.lua
msgid "Tap a job to send a worker. Tap again to cancel a queued job."
msgstr "Tocca un lavoro per mandare un operaio. Tocca di nuovo per annullare un lavoro in coda."

#: games/emergency/lua/emergency_sim.lua
msgid "Tap to assign"
msgstr "Tocca per assegnare"

#: games/emergency/lua/emergency_sim.lua
msgid "Timber yard"
msgstr "Deposito di legname"

