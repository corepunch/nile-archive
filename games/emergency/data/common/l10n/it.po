#: games/emergency/lua/emergency_levels.lua
msgid "City Centre"
msgstr "Centro città"

#: games/emergency/lua/emergency_levels.lua
msgid "City Centre: restore every evacuation route and bring the remaining residents and pets to headquarters."
msgstr "Centro città: ripristina ogni via di evacuazione e porta i residenti e gli animali rimasti al quartier generale."

#: games/emergency/lua/emergency_levels.lua
msgid "Cut-off District"
msgstr "Distretto isolato"

#: games/emergency/lua/emergency_levels.lua
msgid "Cut-off District: reopen the surviving roads around the cooled lava and reach each isolated group."
msgstr "Distretto isolato: riapri le strade sopravvissute attorno alla lava raffreddata e raggiungi ogni gruppo isolato."

#: games/emergency/lua/emergency_levels.lua
msgid "Outskirts"
msgstr "Periferia"

#: games/emergency/lua/emergency_levels.lua
msgid "Outskirts: reopen the roads and reach four residents. Repair stations to restore automatic supplies."
msgstr "Periferia: riapri le strade e raggiungi quattro residenti. Ripara le stazioni per ripristinare i rifornimenti automatici."

#: games/emergency/lua/emergency_levels.lua
msgid "Suburbs"
msgstr "Sobborghi"

#: games/emergency/lua/emergency_levels.lua
msgid "Suburbs: reconnect the homes and timber yard. Restore the office to fund heavy debris removal."
msgstr "Sobborghi: ricollega le case e il deposito di legname. Ripristina l'ufficio per finanziare la rimozione dei detriti pesanti."

#: games/emergency/lua/emergency_levels.lua
msgid "Town Square"
msgstr "Piazza del paese"

#: games/emergency/lua/emergency_levels.lua
msgid "Town Square: reopen the inner streets and rescue the repair crew. Stations supply resources automatically."
msgstr "Piazza del paese: riapri le strade interne e salva la squadra di riparazione. Le stazioni forniscono risorse in automatico."

