msgid "Candlelight shop"
msgstr "Boutique aux chandelles"

#: games/christmas-market/lua/buildings.lua
msgid "Candy canes"
msgstr "Sucres d'orge"

#: games/christmas-market/lua/buildings.lua
msgid "Carrot nose, coal buttons, red scarf."
msgstr "Nez en carotte, boutons de charbon, écharpe rouge."

#: games/christmas-market/lua/buildings.lua
msgid "Carved from the frozen lake."
msgstr "Sculpté dans le lac gelé."

