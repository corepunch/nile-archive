msgstr "등불 산책길"

#: games/christmas-market/lua/campaign.lua
msgid "Last Train Home"
msgstr "집으로 가는 마지막 기차"

#: games/christmas-market/lua/campaign.lua
msgid "Light every blue pane."
msgstr "파란 유리창을 모두 밝히세요."

#: games/christmas-market/lua/campaign.lua
msgid "Little Angel"
msgstr "작은 천사"

#: games/christmas-market/lua/campaign.lua
msgid "Mantel Stockings"
msgstr "벽난로 선반 양말"

#: games/christmas-market/lua/campaign.lua
msgid "Marzipan Pantry"
msgstr "마지판 저장고"

#: games/christmas-market/lua/campaign.lua
msgid "Match through a tied treat to untangle it. Then light its pane."
msgstr "묶인 간식 위에서 맞춰 풀어 주세요. 그런 다음 그 칸의 유리창을 밝히세요."

#: games/christmas-market/lua/campaign.lua
msgid "Midnight Bells"
msgstr "자정의 종"

#: games/christmas-market/lua/campaign.lua
msgid "Midnight Mass"
msgstr "자정 미사"

#: games/christmas-market/lua/campaign.lua
msgid "Midnight Star"
msgstr "자정의 별"

#: games/christmas-market/lua/campaign.lua
msgid "Mistletoe Arch"
msgstr "겨우살이 아치"

#: games/christmas-market/lua/campaign.lua
msgid "Mitten Line"
msgstr "벙어리장갑 줄"

#: games/christmas-market/lua/campaign.lua
msgid "Nutcracker"
msgstr "호두까기 인형"

#: games/christmas-market/lua/campaign.lua
msgid "Nutcracker Parade"
msgstr "호두까기 인형 행진"

#: games/christmas-market/lua/campaign.lua
msgid "Nutcracker Watch"
msgstr "호두까기 인형 파수"

#: games/christmas-market/lua/campaign.lua
msgid "Ornament"
msgstr "장식 오너먼트"

#: games/christmas-market/lua/campaign.lua
msgid "Paper Lantern Walk"
msgstr "종이 등불 산책"

#: games/christmas-market/lua/campaign.lua
msgid "Peppermint Swirl"
msgstr "페퍼민트 소용돌이"

#: games/christmas-market/lua/campaign.lua
msgid "Pine Boughs"
msgstr "소나무 가지"

#: games/christmas-market/lua/campaign.lua
msgid "Pine Whisper"
msgstr "솔바람 속삭임"

#: games/christmas-market/lua/campaign.lua
msgid "Pudding Hearth"
msgstr "푸딩 난로"

