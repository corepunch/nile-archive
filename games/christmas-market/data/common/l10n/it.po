msgstr "Naso di carota, bottoni di carbone, sciarpa rossa."

#: games/christmas-market/lua/buildings.lua
msgid "Carved from the frozen lake."
msgstr "Scolpito nel lago gelato."

#: games/christmas-market/lua/buildings.lua
