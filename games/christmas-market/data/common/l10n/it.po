#: games/christmas-market/lua/buildings.lua
msgid "Letters and parcels are sorted by destination before they leave the market."
msgstr "Lettere e pacchi vengono smistati per destinazione prima di lasciare il mercato."

#: games/christmas-market/lua/buildings.lua
msgid "Letters to Santa"
msgstr "Lettere a Babbo Natale"

#: games/christmas-market/lua/buildings.lua
msgid "Lumber workshop"
msgstr "Falegnameria"

#: games/christmas-market/lua/buildings.lua
msgid "Masons dress stone in the chapel yard. The cut blocks supply foundations for the market."
msgstr "I muratori sbozzano la pietra nel cortile della cappella. I blocchi tagliati forniscono le fondamenta del mercato."

#: games/christmas-market/lua/buildings.lua
msgid "North Pole post office"
msgstr "Ufficio postale del Polo Nord"

#: games/christmas-market/lua/buildings.lua
msgid "Nutcracker guard"
msgstr "Guardia schiaccianoci"

#: games/christmas-market/lua/buildings.lua
msgid "One bauble too big for any tree."
msgstr "Una pallina troppo grande per qualsiasi albero."

#: games/christmas-market/lua/buildings.lua
msgid "Penguin pair"
msgstr "Coppia di pinguini"

#: games/christmas-market/lua/buildings.lua
msgid "Peppermint stripes in a snow drift."
msgstr "Strisce di menta in un cumulo di neve."

#: games/christmas-market/lua/buildings.lua
msgid "Pile of presents"
msgstr "Mucchio di regali"

#: games/christmas-market/lua/buildings.lua
