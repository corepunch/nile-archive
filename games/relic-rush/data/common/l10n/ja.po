msgstr "太い鎖は2回のマッチで壊れます。そのあとプレートを消そう。"

#: games/relic-rush/lua/campaign.lua
msgid "Idol Head"
msgstr "偶像の頭"

#: games/relic-rush/lua/campaign.lua
msgid "Idol of Rain"
msgstr "雨の偶像"

#: games/relic-rush/lua/campaign.lua
msgid "Idol of Salt"
msgstr "塩の偶像"

#: games/relic-rush/lua/campaign.lua
msgid "Inner Sun Court"
msgstr "内なる太陽の中庭"

#: games/relic-rush/lua/campaign.lua
msgid "Jade Cartouche"
msgstr "翡翠のカルトゥーシュ"

#: games/relic-rush/lua/campaign.lua
msgid "Jade Steps"
msgstr "翡翠の階段"

#: games/relic-rush/lua/campaign.lua
msgid "Jaguar Gate"
msgstr "ジャガーの門"

#: games/relic-rush/lua/campaign.lua
msgid "Jaguar Lintel"
msgstr "ジャガーの楣"

#: games/relic-rush/lua/campaign.lua
msgid "Kapok Roots"
msgstr "カポックの根"

#: games/relic-rush/lua/campaign.lua
msgid "Kelp Terrace"
msgstr "コンブのテラス"

#: games/relic-rush/lua/campaign.lua
msgid "Lantern Spiral"
