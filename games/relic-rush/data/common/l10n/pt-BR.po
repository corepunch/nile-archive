#: games/relic-rush/lua/buildings.lua
msgid "Great aviary"
msgstr "Grande viveiro de aves"

#: games/relic-rush/lua/buildings.lua
msgid "Hanging gardens"
msgstr "Jardins suspensos"

#: games/relic-rush/lua/buildings.lua
msgid "Harbour lodge"
msgstr "Alojamento do porto"

#: games/relic-rush/lua/buildings.lua
msgid "Harbour plaza"
msgstr "Praça do porto"

#: games/relic-rush/lua/buildings.lua
msgid "Herbalist's hut"
msgstr "Cabana da herborista"

#: games/relic-rush/lua/buildings.lua
msgid "Island growers bring fruit and grain to market. The stalls pack provisions in clay jars for the road."
msgstr "Os lavradores da ilha trazem frutas e grãos ao mercado. As barracas embalam provisões em potes de barro para a estrada."

