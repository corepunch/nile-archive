#: games/relic-rush/lua/buildings.lua
msgid "Picnic rug"
msgstr "Toalha de piquenique"

#: games/relic-rush/lua/buildings.lua
msgid "Place this treasure anywhere on open grass."
msgstr "Coloque este tesouro em qualquer lugar do gramado livre."

#: games/relic-rush/lua/buildings.lua
msgid "Porters use the lowest dry step to board a boat. As the tide rises they move their baskets up the stone stair, one landing at a time."
msgstr "Os carregadores usam o degrau seco mais baixo para embarcar. Conforme a maré sobe, levam os cestos pela escada de pedra, um patamar de cada vez."

#: games/relic-rush/lua/buildings.lua
msgid "Quarry stone is squared and sorted here before it is traded to the island's builders."
msgstr "A pedra da pedreira é esquadrejada e separada aqui antes de ser vendida aos construtores da ilha."

#: games/relic-rush/lua/buildings.lua
msgid "Quay steps"
msgstr "Degraus do cais"

#: games/relic-rush/lua/buildings.lua
msgid "Rainbow garden"
msgstr "Jardim arco-íris"

#: games/relic-rush/lua/buildings.lua
msgid "Red hibiscus"
msgstr "Hibisco vermelho"

#: games/relic-rush/lua/buildings.lua
msgid "Relic museum"
msgstr "Museu das relíquias"

#: games/relic-rush/lua/buildings.lua
msgid "Riverside reeds"
msgstr "Juncos da margem"

#: games/relic-rush/lua/buildings.lua
msgid "Rock spring"
msgstr "Nascente na rocha"

#: games/relic-rush/lua/buildings.lua
