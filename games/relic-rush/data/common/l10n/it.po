#: games/relic-rush/lua/buildings.lua
msgid "Forest fern"
msgstr "Felce di bosco"

#: games/relic-rush/lua/buildings.lua
msgid "Frangipani"
msgstr "Frangipani"

#: games/relic-rush/lua/buildings.lua
msgid "Fruit pickers keep a sleeping platform among the branches. A watcher with a rattle can turn a flock away before it strips the ripest tree."
msgstr "I raccoglitori di frutta tengono una piattaforma per dormire tra i rami. Una vedetta con una raganella può mandare via uno stormo prima che spogli l'albero più maturo."

#: games/relic-rush/lua/buildings.lua
msgid "Garden bench"
msgstr "Panchina da giardino"

#: games/relic-rush/lua/buildings.lua
