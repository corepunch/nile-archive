#: games/relic-rush/lua/buildings.lua
msgid "Picnic rug"
msgstr "Coperta da picnic"

#: games/relic-rush/lua/buildings.lua
msgid "Place this treasure anywhere on open grass."
msgstr "Metti questo tesoro dove vuoi, su un prato libero."

#: games/relic-rush/lua/buildings.lua
msgid "Porters use the lowest dry step to board a boat. As the tide rises they move their baskets up the stone stair, one landing at a time."
msgstr "I facchini usano il gradino asciutto più basso per salire sulle barche. Quando la marea sale spostano i cesti sulla scala di pietra, un pianerottolo alla volta."

#: games/relic-rush/lua/buildings.lua
msgid "Quarry stone is squared and sorted here before it is traded to the island's builders."
msgstr "Qui la pietra di cava viene squadrata e selezionata prima di essere venduta ai costruttori dell'isola."

#: games/relic-rush/lua/buildings.lua
msgid "Quay steps"
msgstr "Gradini della banchina"

#: games/relic-rush/lua/buildings.lua
msgid "Rainbow garden"
msgstr "Giardino arcobaleno"

#: games/relic-rush/lua/buildings.lua
msgid "Red hibiscus"
msgstr "Ibisco rosso"

#: games/relic-rush/lua/buildings.lua
msgid "Relic museum"
msgstr "Museo delle reliquie"

#: games/relic-rush/lua/buildings.lua
msgid "Riverside reeds"
msgstr "Canne sul fiume"

#: games/relic-rush/lua/buildings.lua
msgid "Rock spring"
msgstr "Sorgente tra le rocce"

