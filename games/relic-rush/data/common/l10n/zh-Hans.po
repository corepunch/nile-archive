#: games/relic-rush/lua/buildings.lua
msgid "Lily pond"
msgstr "睡莲池"

#: games/relic-rush/lua/buildings.lua
msgid "Little fountain"
msgstr "小喷泉"

#: games/relic-rush/lua/buildings.lua
msgid "Mango tree"
msgstr "芒果树"

#: games/relic-rush/lua/buildings.lua
msgid "Market cart"
msgstr "集市推车"

#: games/relic-rush/lua/buildings.lua
msgid "Mess hall"
msgstr "食堂"

#: games/relic-rush/lua/buildings.lua
msgid "Mossy boulders"
msgstr "长满青苔的巨石"

#: games/relic-rush/lua/buildings.lua
msgid "Palm hammock"
msgstr "棕榈吊床"

#: games/relic-rush/lua/buildings.lua
msgid "Papaya tree"
msgstr "木瓜树"

#: games/relic-rush/lua/buildings.lua
msgid "Parrot perch"
msgstr "鹦鹉栖木"

#: games/relic-rush/lua/buildings.lua
msgid "Picnic rug"
msgstr "野餐毯"

#: games/relic-rush/lua/buildings.lua
msgid "Place this treasure anywhere on open grass."
msgstr "可把这件珍宝放在任何一片空草地上。"

#: games/relic-rush/lua/buildings.lua
msgid "Porters use the lowest dry step to board a boat. As the tide rises they move their baskets up the stone stair, one landing at a time."
msgstr "搬运工从最低的干燥台阶登船。潮水上涨时，他们把篮子沿石阶一级一级往上挪。"

#: games/relic-rush/lua/buildings.lua
msgid "Quarry stone is squared and sorted here before it is traded to the island's builders."
msgstr "采石场的石料在这里切方、分拣，再卖给岛上的建筑工。"

#: games/relic-rush/lua/buildings.lua
msgid "Quay steps"
msgstr "码头台阶"

#: games/relic-rush/lua/buildings.lua
msgid "Rainbow garden"
msgstr "彩虹花园"

#: games/relic-rush/lua/buildings.lua
msgid "Red hibiscus"
msgstr "红芙蓉"

#: games/relic-rush/lua/buildings.lua
msgid "Relic museum"
msgstr "遗物博物馆"

#: games/relic-rush/lua/buildings.lua
msgid "Riverside reeds"
msgstr "河边芦苇"

#: games/relic-rush/lua/buildings.lua
msgid "Rock spring"
msgstr "岩泉"

#: games/relic-rush/lua/buildings.lua
msgid "Round jungle tree"
msgstr "圆冠丛林树"

#: games/relic-rush/lua/buildings.lua
msgid "Round shrub"
msgstr "圆灌木"

#: games/relic-rush/lua/buildings.lua
msgid "Rowboat"
msgstr "划艇"

#: games/relic-rush/lua/buildings.lua
msgid "Ruined arch"
msgstr "残破的拱门"

#: games/relic-rush/lua/buildings.lua
msgid "Shipwrights salvage valuable cargo and sound timber from the hull while the tide is out."
msgstr "退潮时，造船匠从船壳里抢救贵重货物和完好的木料。"

#: games/relic-rush/lua/buildings.lua
msgid "Sight lines through the stone pillars help navigators mark the positions of stars throughout the year."
msgstr "透过石柱的瞄准线，帮领航员标出全年各颗星星的位置。"

#: games/relic-rush/lua/buildings.lua
msgid "Signpost"
msgstr "路标"

#: games/relic-rush/lua/buildings.lua
msgid "Spring well"
msgstr "泉井"

#: games/relic-rush/lua/buildings.lua
msgid "Star observatory"
msgstr "观星台"

#: games/relic-rush/lua/buildings.lua
msgid "Stilt house"
msgstr "高脚屋"

#: games/relic-rush/lua/buildings.lua
msgid "Stone amphitheatre"
msgstr "石砌露天剧场"

#: games/relic-rush/lua/buildings.lua
msgid "Stone idol"
msgstr "石像"

#: games/relic-rush/lua/buildings.lua
msgid "Stone trading post"
msgstr "石料交易站"

#: games/relic-rush/lua/buildings.lua
msgid "Sun obelisk"
msgstr "太阳方尖碑"

#: games/relic-rush/lua/buildings.lua
msgid "Sundial"
msgstr "日晷"

#: games/relic-rush/lua/buildings.lua
msgid "Sunning turtle"
msgstr "晒太阳的乌龟"

#: games/relic-rush/lua/buildings.lua
msgid "Sunny daisies"
msgstr "向阳雏菊"

#: games/relic-rush/lua/buildings.lua
msgid "Supply crates"
msgstr "补给箱"

#: games/relic-rush/lua/buildings.lua
msgid "Supply tent"
msgstr "补给帐篷"

#: games/relic-rush/lua/buildings.lua
msgid "Temple cypress"
msgstr "神庙柏树"

#: games/relic-rush/lua/buildings.lua
msgid "Temple of the Sun"
msgstr "太阳神庙"

#: games/relic-rush/lua/buildings.lua
msgid "Tender seedlings spend their first weeks under cover. The gardener opens the shelter early, before the midday heat can wilt a whole bed."
msgstr "娇嫩的幼苗头几周要在遮盖下生长。园丁会趁早打开遮棚，免得正午的暑热晒蔫整片苗床。"

#: games/relic-rush/lua/buildings.lua
msgid "The amphitheatre gives the town a place for contests and public gatherings. Armourers set up their stalls at the entrance."
msgstr "露天剧场让小镇有了比赛和集会的场所，铠甲匠在入口处摆起摊位。"

#: games/relic-rush/lua/buildings.lua
msgid "The archive keeps harbour plans and trade records dry. Carved rings serve as seals for official documents."
msgstr "档案馆让港口图纸和贸易记录保持干燥，刻花的指环可以当作公文的印章。"

#: games/relic-rush/lua/buildings.lua
msgid "The camp gives excavation crews a place to sort supplies, mend tools and cook between shifts."
msgstr "营地是挖掘队的落脚处，可以整理补给、修理工具，换班间隙还能生火做饭。"

#: games/relic-rush/lua/buildings.lua
msgid "The harbour watch tracks the tide from this tower. Pilots use its signals to time a shallow crossing."
msgstr "港口守望员在这座塔上观测潮汐，领航员按它的信号掐准浅水通过的时机。"

#: games/relic-rush/lua/buildings.lua
msgid "The herbalist dries leaves on reed trays and keeps the roots in separate clay pots. A sprig tied to each lid tells an apprentice which plant grew it."
msgstr "药草师把叶子摊在芦苇托盘上晾干，根茎则分装在不同的陶罐里。每个罐盖上系一小枝，徒弟一看就知道是哪种植物。"

#: games/relic-rush/lua/buildings.lua
msgid "The lodge gives visiting crews a dry berth and a place to prepare for their next departure."
msgstr "客舍给来访的船员一个干爽的铺位，也是他们准备下次起航的地方。"

#: games/relic-rush/lua/buildings.lua
msgid "The museum keeps the island's carvings and instruments together, where visitors can see how they were made."
msgstr "博物馆把岛上的雕刻和仪器收藏在一起，参观者可以看看它们是怎么做成的。"

#: games/relic-rush/lua/buildings.lua
msgid "The sawbench turns logs into beams and planks for houses and boats."
msgstr "锯木台把原木锯成横梁和木板，用来造房子和造船。"

#: games/relic-rush/lua/buildings.lua
msgid "The stone lining keeps loose earth out of the spring. A low rim makes it easy to fill buckets."
msgstr "石砌的井壁挡住松散的泥土，不让它落进泉水，低矮的井沿方便打水。"

#: games/relic-rush/lua/buildings.lua
msgid "The stream turns the millwheel. Inside, millstones grind the island's harvest into flour."
msgstr "溪水推动水车，磨坊里的石磨把岛上的收成磨成面粉。"

#: games/relic-rush/lua/buildings.lua
msgid "The temple courtyard hosts public ceremonies and feast days under the island's sun emblem."
msgstr "神庙庭院在岛上的太阳徽记下，举行公共仪式和节日盛宴。"

#: games/relic-rush/lua/buildings.lua
msgid "Tide clock tower"
msgstr "潮汐钟楼"

#: games/relic-rush/lua/buildings.lua
msgid "Tiki torch"
msgstr "提基火炬"

#: games/relic-rush/lua/buildings.lua
msgid "Timber posts carry the sleeping floor above the flood line. A family can tie its boat to the steps and come home even when the lane is under water."
msgstr "木桩把卧室地板托在洪水线之上。就算小巷被水淹了，一家人也能把船拴在台阶上，照样回家。"

#: games/relic-rush/lua/buildings.lua
msgid "Topiary ball"
msgstr "修剪成球的灌木"

#: games/relic-rush/lua/buildings.lua
msgid "Toucan perch"
msgstr "巨嘴鸟栖木"

#: games/relic-rush/lua/buildings.lua
msgid "Trapper's cabin"
msgstr "猎人小屋"

#: games/relic-rush/lua/buildings.lua
msgid "Trappers shelter here between trips. The cabin gives them a dry bench for repairing traps and gear."
msgstr "猎人们在两次出猎之间在这里歇脚，小屋里有张干爽的长凳，供他们修补陷阱和装备。"

#: games/relic-rush/lua/buildings.lua
msgid "Treasure chest"
msgstr "宝箱"

#: games/relic-rush/lua/buildings.lua
msgid "Twin palms"
msgstr "双生棕榈"

#: games/relic-rush/lua/buildings.lua
msgid "Vine pergola"
msgstr "藤蔓棚架"

#: games/relic-rush/lua/buildings.lua
msgid "Water from the spring flows through the fountain into a basin faced with green stone."
msgstr "泉水流过喷泉，注入一座镶着青石的水池。"

#: games/relic-rush/lua/buildings.lua
msgid "Water mill"
msgstr "水磨坊"

#: games/relic-rush/lua/buildings.lua
msgid "Water pump"
msgstr "水泵"

#: games/relic-rush/lua/buildings.lua
msgid "Wild orchids"
msgstr "野生兰花"

#: games/relic-rush/lua/buildings.lua
msgid "Young palm"
msgstr "小棕榈"

