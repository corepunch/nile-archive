msgstr "盐神像"

#: games/relic-rush/lua/campaign.lua
msgid "Inner Sun Court"
msgstr "内层太阳庭院"

#: games/relic-rush/lua/campaign.lua
msgid "Jade Cartouche"
msgstr "翡翠王名圈"

#: games/relic-rush/lua/campaign.lua
msgid "Jade Steps"
msgstr "翡翠台阶"

#: games/relic-rush/lua/campaign.lua
msgid "Jaguar Gate"
msgstr "美洲豹之门"

#: games/relic-rush/lua/campaign.lua
msgid "Jaguar Lintel"
msgstr "美洲豹门楣"

#: games/relic-rush/lua/campaign.lua
msgid "Kapok Roots"
msgstr "木棉根"

#: games/relic-rush/lua/campaign.lua
