msgstr "灯笼螺旋"

#: games/relic-rush/lua/campaign.lua
msgid "Lantern Tower"
msgstr "灯笼塔"

#: games/relic-rush/lua/campaign.lua
msgid "Lookout Mesa"
msgstr "瞭望台地"

#: games/relic-rush/lua/campaign.lua
msgid "Match through a chained piece to free it. Then clear the plaque underneath."
msgstr "匹配被锁链缠住的棋子，把它解放出来。然后清除下面的铭牌。"

#: games/relic-rush/lua/campaign.lua
msgid "Maw of the Jaguar"
msgstr "美洲豹之口"

#: games/relic-rush/lua/campaign.lua
msgid "Mist Cenote"
msgstr "雾中天然井"

