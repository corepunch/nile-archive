#: games/relic-rush/lua/buildings.lua
msgid "A brazier above the harbour marks the entrance at night, when the reefs are hardest to see."
msgstr "Жаровня над гаванью указывает вход ночью, когда рифы почти не видны."

#: games/relic-rush/lua/buildings.lua
msgid "Bamboo grove"
msgstr "Бамбуковая роща"

#: games/relic-rush/lua/buildings.lua
msgid "Banana plant"
msgstr "Банановое растение"

#: games/relic-rush/lua/buildings.lua
msgid "Barrels"
msgstr "Бочки"

#: games/relic-rush/lua/buildings.lua
msgid "Beached schooner"
msgstr "Шхуна на берегу"

#: games/relic-rush/lua/buildings.lua
msgid "Berry bush"
msgstr "Ягодный куст"

#: games/relic-rush/lua/buildings.lua
msgid "Big-leaf monstera"
msgstr "Монстера с большими листьями"

#: games/relic-rush/lua/buildings.lua
msgid "Birdbath"
msgstr "Птичья купальня"

#: games/relic-rush/lua/buildings.lua
msgid "Blooming bromeliad"
msgstr "Цветущая бромелия"

#: games/relic-rush/lua/buildings.lua
msgid "Blue lilies"
msgstr "Синие лилии"

#: games/relic-rush/lua/buildings.lua
msgid "Boulder"
msgstr "Валун"

#: games/relic-rush/lua/buildings.lua
msgid "Broken column"
msgstr "Сломанная колонна"

#: games/relic-rush/lua/buildings.lua
msgid "Campfire"
msgstr "Костёр"

#: games/relic-rush/lua/buildings.lua
msgid "Canopy treehouse"
msgstr "Домик в кронах"

#: games/relic-rush/lua/buildings.lua
msgid "Capybara"
msgstr "Капибара"

#: games/relic-rush/lua/buildings.lua
msgid "Carpenter's workshop"
msgstr "Плотницкая мастерская"

#: games/relic-rush/lua/buildings.lua
msgid "Cartographer's house"
msgstr "Дом картографа"

#: games/relic-rush/lua/buildings.lua
msgid "Cartographers combine soundings from different crews to mark reefs and channels on a single chart."
msgstr "Картографы собирают промеры глубин от разных команд и наносят рифы и проходы на одну карту."

#: games/relic-rush/lua/buildings.lua
msgid "Clipped hedge block"
msgstr "Стриженая изгородь"

#: games/relic-rush/lua/buildings.lua
msgid "Crews bring their own bowls to the long tables. One cook can feed a whole shift while the hearth is hot and have the grain soaking for the next."
msgstr "Команды приходят с мисками к длинным столам. Пока горит очаг, один повар кормит целую смену и уже замачивает зерно для следующей."

#: games/relic-rush/lua/buildings.lua
msgid "Crews carry homing birds aboard to send messages back to shore. The loft keeps the birds safe between voyages."
msgstr "Команды берут на борт почтовых голубей, чтобы слать вести на берег. Голубятня хранит птиц между плаваниями."

#: games/relic-rush/lua/buildings.lua
msgid "Crystal cluster"
msgstr "Друза кристаллов"

#: games/relic-rush/lua/buildings.lua
msgid "Curious monkey"
msgstr "Любопытная обезьянка"

#: games/relic-rush/lua/buildings.lua
msgid "Dig site"
msgstr "Раскоп"

#: games/relic-rush/lua/buildings.lua
msgid "Duck pond"
msgstr "Утиный пруд"

#: games/relic-rush/lua/buildings.lua
msgid "Each terrace drains into the bed below. Gardeners carry water to the top at dawn and plant the thirstiest herbs where the first runnel falls."
msgstr "Каждая терраса стекает в грядку ниже. На рассвете садовники несут воду наверх и сажают самые жаждущие травы там, где падает первая струйка."

#: games/relic-rush/lua/buildings.lua
msgid "Expedition camp"
msgstr "Лагерь экспедиции"

#: games/relic-rush/lua/buildings.lua
msgid "Expedition flag"
msgstr "Флаг экспедиции"

#: games/relic-rush/lua/buildings.lua
msgid "Explorer statue"
msgstr "Статуя исследователя"

#: games/relic-rush/lua/buildings.lua
msgid "Explorer's globe"
msgstr "Глобус исследователя"

#: games/relic-rush/lua/buildings.lua
msgid "Fan palm"
msgstr "Веерная пальма"

#: games/relic-rush/lua/buildings.lua
msgid "Field telescope"
msgstr "Полевая подзорная труба"

#: games/relic-rush/lua/buildings.lua
msgid "Fishing boats unload at the harbour plaza. The catch goes straight from the quay to the market stalls."
msgstr "Рыбацкие лодки разгружаются на портовой площади. Улов идёт с причала прямо на прилавки."

#: games/relic-rush/lua/buildings.lua
msgid "Flower bed"
msgstr "Клумба"

#: games/relic-rush/lua/buildings.lua
msgid "Flower planter"
msgstr "Цветочный горшок"

#: games/relic-rush/lua/buildings.lua
msgid "Flowering shrub"
msgstr "Цветущий кустарник"

#: games/relic-rush/lua/buildings.lua
msgid "Forest fern"
msgstr "Лесной папоротник"

#: games/relic-rush/lua/buildings.lua
msgid "Frangipani"
msgstr "Франжипани"

#: games/relic-rush/lua/buildings.lua
msgid "Fruit pickers keep a sleeping platform among the branches. A watcher with a rattle can turn a flock away before it strips the ripest tree."
msgstr "Сборщики фруктов устроили среди ветвей спальную площадку. Сторож с трещоткой отгонит стаю, пока она не обобрала самое спелое дерево."

#: games/relic-rush/lua/buildings.lua
msgid "Garden bench"
msgstr "Садовая скамья"

#: games/relic-rush/lua/buildings.lua
msgid "Garden swing"
msgstr "Садовые качели"

#: games/relic-rush/lua/buildings.lua
msgid "Giant kapok"
msgstr "Гигантская сейба"

#: games/relic-rush/lua/buildings.lua
msgid "Giant stone head"
msgstr "Гигантская каменная голова"

#: games/relic-rush/lua/buildings.lua
msgid "Glass greenhouse"
msgstr "Стеклянная оранжерея"

#: games/relic-rush/lua/buildings.lua
msgid "Golden idol"
msgstr "Золотой идол"

#: games/relic-rush/lua/buildings.lua
msgid "Great aviary"
msgstr "Большой птичник"

#: games/relic-rush/lua/buildings.lua
msgid "Hanging gardens"
msgstr "Висячие сады"

#: games/relic-rush/lua/buildings.lua
msgid "Harbour lodge"
msgstr "Портовый приют"

#: games/relic-rush/lua/buildings.lua
msgid "Harbour plaza"
msgstr "Портовая площадь"

#: games/relic-rush/lua/buildings.lua
msgid "Herbalist's hut"
msgstr "Хижина травницы"

#: games/relic-rush/lua/buildings.lua
msgid "Island growers bring fruit and grain to market. The stalls pack provisions in clay jars for the road."
msgstr "Островные земледельцы везут на рынок фрукты и зерно. На прилавках провиант укладывают в глиняные кувшины в дорогу."

#: games/relic-rush/lua/buildings.lua
msgid "Jade fountain"
msgstr "Нефритовый фонтан"

#: games/relic-rush/lua/buildings.lua
msgid "Jade gazebo"
msgstr "Нефритовая беседка"

#: games/relic-rush/lua/buildings.lua
msgid "Jaguar guardian"
msgstr "Ягуар-страж"

#: games/relic-rush/lua/buildings.lua
msgid "Jungle market"
msgstr "Рынок в джунглях"

#: games/relic-rush/lua/buildings.lua
msgid "Keeper's archive"
msgstr "Архив хранителя"

#: games/relic-rush/lua/buildings.lua
msgid "Lantern post"
msgstr "Фонарный столб"

#: games/relic-rush/lua/buildings.lua
msgid "Lighthouse"
msgstr "Маяк"

#: games/relic-rush/lua/buildings.lua
msgid "Lily pond"
msgstr "Пруд с кувшинками"

#: games/relic-rush/lua/buildings.lua
msgid "Little fountain"
msgstr "Маленький фонтан"

#: games/relic-rush/lua/buildings.lua
msgid "Mango tree"
msgstr "Манговое дерево"

#: games/relic-rush/lua/buildings.lua
msgid "Market cart"
msgstr "Рыночная тележка"

#: games/relic-rush/lua/buildings.lua
msgid "Mess hall"
msgstr "Столовая"

#: games/relic-rush/lua/buildings.lua
msgid "Mossy boulders"
msgstr "Замшелые валуны"

#: games/relic-rush/lua/buildings.lua
msgid "Palm hammock"
msgstr "Гамак между пальм"

#: games/relic-rush/lua/buildings.lua
msgid "Papaya tree"
msgstr "Дерево папайи"

#: games/relic-rush/lua/buildings.lua
msgid "Parrot perch"
msgstr "Жердочка для попугая"

#: games/relic-rush/lua/buildings.lua
msgid "Picnic rug"
msgstr "Плед для пикника"

#: games/relic-rush/lua/buildings.lua
msgid "Place this treasure anywhere on open grass."
msgstr "Ставь это сокровище на любой свободной траве."

#: games/relic-rush/lua/buildings.lua
msgid "Porters use the lowest dry step to board a boat. As the tide rises they move their baskets up the stone stair, one landing at a time."
msgstr "Носильщики садятся в лодку с нижней сухой ступени. С приливом они переносят корзины вверх по каменной лестнице, площадка за площадкой."

#: games/relic-rush/lua/buildings.lua
msgid "Quarry stone is squared and sorted here before it is traded to the island's builders."
msgstr "Карьерный камень здесь тешут и сортируют, прежде чем отдать островным строителям."

#: games/relic-rush/lua/buildings.lua
msgid "Quay steps"
msgstr "Ступени причала"

#: games/relic-rush/lua/buildings.lua
msgid "Rainbow garden"
msgstr "Радужный сад"

#: games/relic-rush/lua/buildings.lua
msgid "Red hibiscus"
msgstr "Красный гибискус"

#: games/relic-rush/lua/buildings.lua
msgid "Relic museum"
msgstr "Музей реликвий"

#: games/relic-rush/lua/buildings.lua
msgid "Riverside reeds"
msgstr "Камыш у реки"

#: games/relic-rush/lua/buildings.lua
msgid "Rock spring"
msgstr "Родник в скалах"

#: games/relic-rush/lua/buildings.lua
msgid "Round jungle tree"
msgstr "Круглое дерево джунглей"

#: games/relic-rush/lua/buildings.lua
msgid "Round shrub"
msgstr "Круглый кустик"

#: games/relic-rush/lua/buildings.lua
msgid "Rowboat"
msgstr "Гребная лодка"

#: games/relic-rush/lua/buildings.lua
msgid "Ruined arch"
msgstr "Разрушенная арка"

#: games/relic-rush/lua/buildings.lua
msgid "Shipwrights salvage valuable cargo and sound timber from the hull while the tide is out."
msgstr "Корабелы достают из корпуса ценный груз и крепкие брёвна, пока отлив."

#: games/relic-rush/lua/buildings.lua
msgid "Sight lines through the stone pillars help navigators mark the positions of stars throughout the year."
msgstr "Линии взгляда между каменными столбами помогают штурманам отмечать положение звёзд в течение года."

#: games/relic-rush/lua/buildings.lua
msgid "Signpost"
msgstr "Указатель"

#: games/relic-rush/lua/buildings.lua
msgid "Spring well"
msgstr "Колодец у родника"

#: games/relic-rush/lua/buildings.lua
msgid "Star observatory"
msgstr "Звёздная обсерватория"

#: games/relic-rush/lua/buildings.lua
msgid "Stilt house"
msgstr "Дом на сваях"

#: games/relic-rush/lua/buildings.lua
msgid "Stone amphitheatre"
msgstr "Каменный амфитеатр"

#: games/relic-rush/lua/buildings.lua
msgid "Stone idol"
msgstr "Каменный идол"

#: games/relic-rush/lua/buildings.lua
msgid "Stone trading post"
msgstr "Каменная торговая лавка"

#: games/relic-rush/lua/buildings.lua
msgid "Sun obelisk"
msgstr "Солнечный обелиск"

#: games/relic-rush/lua/buildings.lua
msgid "Sundial"
msgstr "Солнечные часы"

#: games/relic-rush/lua/buildings.lua
msgid "Sunning turtle"
msgstr "Черепаха на солнышке"

#: games/relic-rush/lua/buildings.lua
msgid "Sunny daisies"
msgstr "Солнечные ромашки"

#: games/relic-rush/lua/buildings.lua
msgid "Supply crates"
msgstr "Ящики с припасами"

#: games/relic-rush/lua/buildings.lua
msgid "Supply tent"
msgstr "Палатка с припасами"

#: games/relic-rush/lua/buildings.lua
msgid "Temple cypress"
msgstr "Храмовый кипарис"

#: games/relic-rush/lua/buildings.lua
msgid "Temple of the Sun"
msgstr "Храм Солнца"

#: games/relic-rush/lua/buildings.lua
msgid "Tender seedlings spend their first weeks under cover. The gardener opens the shelter early, before the midday heat can wilt a whole bed."
msgstr "Нежные саженцы первые недели растут под навесом. Садовник открывает его пораньше, пока полуденный зной не высушил целую грядку."

#: games/relic-rush/lua/buildings.lua
msgid "The amphitheatre gives the town a place for contests and public gatherings. Armourers set up their stalls at the entrance."
msgstr "Амфитеатр — место для состязаний и общих сборов. У входа раскладывают товар оружейники."

#: games/relic-rush/lua/buildings.lua
msgid "The archive keeps harbour plans and trade records dry. Carved rings serve as seals for official documents."
msgstr "В архиве сухо хранятся планы гавани и торговые записи. Резные кольца служат печатями для официальных бумаг."

#: games/relic-rush/lua/buildings.lua
msgid "The camp gives excavation crews a place to sort supplies, mend tools and cook between shifts."
msgstr "В лагере раскопщики разбирают припасы, чинят инструмент и готовят еду между сменами."

#: games/relic-rush/lua/buildings.lua
msgid "The harbour watch tracks the tide from this tower. Pilots use its signals to time a shallow crossing."
msgstr "Портовая стража следит за приливом с этой башни. Лоцманы по её сигналам выбирают время для прохода по мелководью."

#: games/relic-rush/lua/buildings.lua
msgid "The herbalist dries leaves on reed trays and keeps the roots in separate clay pots. A sprig tied to each lid tells an apprentice which plant grew it."
msgstr "Травница сушит листья на тростниковых подносах, а корни держит в отдельных глиняных горшках. Веточка на каждой крышке подсказывает ученику, какое растение внутри."

#: games/relic-rush/lua/buildings.lua
msgid "The lodge gives visiting crews a dry berth and a place to prepare for their next departure."
msgstr "В приюте приезжие команды находят сухую койку и место, чтобы подготовиться к следующему отплытию."

#: games/relic-rush/lua/buildings.lua
msgid "The museum keeps the island's carvings and instruments together, where visitors can see how they were made."
msgstr "В музее собраны островные резные работы и инструменты, и гости могут увидеть, как их делали."

#: games/relic-rush/lua/buildings.lua
msgid "The sawbench turns logs into beams and planks for houses and boats."
msgstr "Пильный станок превращает брёвна в балки и доски для домов и лодок."

#: games/relic-rush/lua/buildings.lua
msgid "The stone lining keeps loose earth out of the spring. A low rim makes it easy to fill buckets."
msgstr "Каменная обшивка не пускает землю в родник. Низкий край удобен, чтобы набирать вёдра."

#: games/relic-rush/lua/buildings.lua
msgid "The stream turns the millwheel. Inside, millstones grind the island's harvest into flour."
msgstr "Ручей вращает мельничное колесо. Внутри жернова мелют островной урожай в муку."

#: games/relic-rush/lua/buildings.lua
msgid "The temple courtyard hosts public ceremonies and feast days under the island's sun emblem."
msgstr "Во дворе храма проходят общие церемонии и праздники под солнечным знаком острова."

#: games/relic-rush/lua/buildings.lua
msgid "Tide clock tower"
msgstr "Башня приливных часов"

#: games/relic-rush/lua/buildings.lua
msgid "Tiki torch"
msgstr "Факел-тики"

#: games/relic-rush/lua/buildings.lua
msgid "Timber posts carry the sleeping floor above the flood line. A family can tie its boat to the steps and come home even when the lane is under water."
msgstr "Деревянные сваи поднимают спальный пол над уровнем паводка. Семья привязывает лодку к ступеням и возвращается домой, даже когда улица под водой."

#: games/relic-rush/lua/buildings.lua
msgid "Topiary ball"
msgstr "Фигурный шар из кустов"

#: games/relic-rush/lua/buildings.lua
msgid "Toucan perch"
msgstr "Жердочка для туканов"

#: games/relic-rush/lua/buildings.lua
msgid "Trapper's cabin"
msgstr "Хижина охотника"

#: games/relic-rush/lua/buildings.lua
msgid "Trappers shelter here between trips. The cabin gives them a dry bench for repairing traps and gear."
msgstr "Охотники отдыхают здесь между вылазками. В хижине есть сухая скамья, чтобы чинить ловушки и снаряжение."

#: games/relic-rush/lua/buildings.lua
msgid "Treasure chest"
msgstr "Сундук с сокровищами"

#: games/relic-rush/lua/buildings.lua
msgid "Twin palms"
msgstr "Пальмы-близнецы"

#: games/relic-rush/lua/buildings.lua
msgid "Vine pergola"
msgstr "Пергола с лозой"

#: games/relic-rush/lua/buildings.lua
msgid "Water from the spring flows through the fountain into a basin faced with green stone."
msgstr "Вода из родника течёт через фонтан в чашу, облицованную зелёным камнем."

#: games/relic-rush/lua/buildings.lua
msgid "Water mill"
msgstr "Водяная мельница"

#: games/relic-rush/lua/buildings.lua
msgid "Water pump"
msgstr "Водяной насос"

#: games/relic-rush/lua/buildings.lua
msgid "Wild orchids"
msgstr "Дикие орхидеи"

#: games/relic-rush/lua/buildings.lua
msgid "Young palm"
msgstr "Молодая пальма"

#: games/relic-rush/lua/campaign.lua
msgid "Arch Gate"
msgstr "Арочные ворота"

#: games/relic-rush/lua/campaign.lua
msgid "Beached Hull"
msgstr "Корпус на берегу"

#: games/relic-rush/lua/campaign.lua
msgid "Bell Cistern"
msgstr "Колокольная цистерна"

#: games/relic-rush/lua/campaign.lua
msgid "Bone Stair"
msgstr "Костяная лестница"

#: games/relic-rush/lua/campaign.lua
msgid "Broken Aqueduct"
msgstr "Разбитый акведук"

#: games/relic-rush/lua/campaign.lua
msgid "Ceiba Roots"
msgstr "Корни сейбы"

#: games/relic-rush/lua/campaign.lua
msgid "Cenote Ring"
msgstr "Кольцо сенота"

#: games/relic-rush/lua/campaign.lua
msgid "Chac Stair"
msgstr "Лестница Чака"

#: games/relic-rush/lua/campaign.lua
msgid "Choked Gateway"
msgstr "Заросший проход"

#: games/relic-rush/lua/campaign.lua
msgid "Clear every turquoise plaque."
msgstr "Убери все бирюзовые таблички."

#: games/relic-rush/lua/campaign.lua
msgid "Coiled Serpent"
msgstr "Свернувшийся змей"

#: games/relic-rush/lua/campaign.lua
msgid "Colonnade Walk"
msgstr "Прогулка по колоннаде"

#: games/relic-rush/lua/campaign.lua
msgid "Cormorant Rock"
msgstr "Скала бакланов"

#: games/relic-rush/lua/campaign.lua
msgid "Dawn Terrace"
msgstr "Терраса рассвета"

#: games/relic-rush/lua/campaign.lua
msgid "Disc of Noon"
msgstr "Диск полудня"

#: games/relic-rush/lua/campaign.lua
msgid "Dome Ring"
msgstr "Кольцо купола"

#: games/relic-rush/lua/campaign.lua
msgid "Drowned Arch"
msgstr "Затопленная арка"

#: games/relic-rush/lua/campaign.lua
msgid "Ember Colonnade"
msgstr "Колоннада углей"

#: games/relic-rush/lua/campaign.lua
msgid "Fallen Colonnade"
msgstr "Павшая колоннада"

#: games/relic-rush/lua/campaign.lua
msgid "Fern Window"
msgstr "Окно в папоротниках"

#: games/relic-rush/lua/campaign.lua
msgid "Ferry Steps"
msgstr "Паромные ступени"

#: games/relic-rush/lua/campaign.lua
msgid "Gate of Reeds"
msgstr "Ворота в камышах"

#: games/relic-rush/lua/campaign.lua
msgid "Hall of Pillars"
msgstr "Зал колонн"

#: games/relic-rush/lua/campaign.lua
msgid "Heart of the Temple"
msgstr "Сердце храма"

#: games/relic-rush/lua/campaign.lua
msgid "Heavy chains take two matches. Then clear their plaques."
msgstr "Тяжёлые цепи выдерживают две комбинации. Потом убери их таблички."

#: games/relic-rush/lua/campaign.lua
msgid "Idol Head"
msgstr "Голова идола"

#: games/relic-rush/lua/campaign.lua
msgid "Idol of Rain"
msgstr "Идол дождя"

#: games/relic-rush/lua/campaign.lua
msgid "Idol of Salt"
msgstr "Идол соли"

#: games/relic-rush/lua/campaign.lua
msgid "Inner Sun Court"
msgstr "Внутренний двор Солнца"

#: games/relic-rush/lua/campaign.lua
msgid "Jade Cartouche"
msgstr "Нефритовый картуш"

#: games/relic-rush/lua/campaign.lua
msgid "Jade Steps"
msgstr "Нефритовые ступени"

#: games/relic-rush/lua/campaign.lua
msgid "Jaguar Gate"
msgstr "Ворота ягуара"

#: games/relic-rush/lua/campaign.lua
msgid "Jaguar Lintel"
msgstr "Притолока ягуара"

#: games/relic-rush/lua/campaign.lua
msgid "Kapok Roots"
