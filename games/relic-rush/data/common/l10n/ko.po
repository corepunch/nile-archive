#: games/relic-rush/lua/buildings.lua
msgid "A brazier above the harbour marks the entrance at night, when the reefs are hardest to see."
msgstr "항구 위의 화로가 암초가 가장 보이지 않는 밤에 입구를 알려 줘요."

#: games/relic-rush/lua/buildings.lua
msgid "Bamboo grove"
msgstr "대나무 숲"

#: games/relic-rush/lua/buildings.lua
msgid "Banana plant"
msgstr "바나나 나무"

#: games/relic-rush/lua/buildings.lua
msgid "Barrels"
msgstr "통"

#: games/relic-rush/lua/buildings.lua
msgid "Beached schooner"
msgstr "좌초한 스쿠너선"

#: games/relic-rush/lua/buildings.lua
msgid "Berry bush"
msgstr "딸기 덤불"

#: games/relic-rush/lua/buildings.lua
msgid "Big-leaf monstera"
msgstr "큰잎 몬스테라"

#: games/relic-rush/lua/buildings.lua
msgid "Birdbath"
msgstr "새 물통"

#: games/relic-rush/lua/buildings.lua
msgid "Blooming bromeliad"
msgstr "꽃핀 브로멜리아"

#: games/relic-rush/lua/buildings.lua
msgid "Blue lilies"
msgstr "푸른 백합"

#: games/relic-rush/lua/buildings.lua
msgid "Boulder"
msgstr "바위"

#: games/relic-rush/lua/buildings.lua
msgid "Broken column"
msgstr "부러진 기둥"

#: games/relic-rush/lua/buildings.lua
msgid "Campfire"
msgstr "모닥불"

#: games/relic-rush/lua/buildings.lua
msgid "Canopy treehouse"
msgstr "나무 위 오두막"

#: games/relic-rush/lua/buildings.lua
msgid "Capybara"
msgstr "카피바라"

#: games/relic-rush/lua/buildings.lua
msgid "Carpenter's workshop"
msgstr "목수의 작업장"

#: games/relic-rush/lua/buildings.lua
msgid "Cartographer's house"
msgstr "지도 제작자의 집"

#: games/relic-rush/lua/buildings.lua
msgid "Cartographers combine soundings from different crews to mark reefs and channels on a single chart."
msgstr "지도 제작자들이 여러 선원의 측심 기록을 모아 암초와 물길을 한 장의 지도에 표시해요."

#: games/relic-rush/lua/buildings.lua
msgid "Clipped hedge block"
msgstr "다듬은 산울타리 블록"

#: games/relic-rush/lua/buildings.lua
msgid "Crews bring their own bowls to the long tables. One cook can feed a whole shift while the hearth is hot and have the grain soaking for the next."
msgstr "선원들이 긴 식탁에 자기 그릇을 가져와요. 요리사 한 명이 화덕이 뜨거운 동안 교대조 전체를 먹이고 다음 곡식을 불려 둬요."

#: games/relic-rush/lua/buildings.lua
msgid "Crews carry homing birds aboard to send messages back to shore. The loft keeps the birds safe between voyages."
msgstr "선원들은 배에 전서구를 싣고 가서 소식을 육지로 보내요. 새장은 항해 사이에 새들을 안전하게 지켜 줘요."

#: games/relic-rush/lua/buildings.lua
msgid "Crystal cluster"
msgstr "수정 무리"

#: games/relic-rush/lua/buildings.lua
msgid "Curious monkey"
msgstr "호기심 많은 원숭이"

#: games/relic-rush/lua/buildings.lua
msgid "Dig site"
msgstr "발굴지"

#: games/relic-rush/lua/buildings.lua
msgid "Duck pond"
msgstr "오리 연못"

#: games/relic-rush/lua/buildings.lua
msgid "Each terrace drains into the bed below. Gardeners carry water to the top at dawn and plant the thirstiest herbs where the first runnel falls."
msgstr "계단식 밭마다 아래 밭으로 물이 빠져요. 정원사는 새벽에 꼭대기까지 물을 나르고, 가장 목마른 허브는 첫 물길이 닿는 곳에 심어요."

#: games/relic-rush/lua/buildings.lua
msgid "Expedition camp"
msgstr "탐험 야영지"

#: games/relic-rush/lua/buildings.lua
msgid "Expedition flag"
msgstr "탐험 깃발"

#: games/relic-rush/lua/buildings.lua
msgid "Explorer statue"
msgstr "탐험가 동상"

#: games/relic-rush/lua/buildings.lua
msgid "Explorer's globe"
msgstr "탐험가의 지구본"

#: games/relic-rush/lua/buildings.lua
msgid "Fan palm"
msgstr "부채야자"

#: games/relic-rush/lua/buildings.lua
msgid "Field telescope"
msgstr "야외 망원경"

#: games/relic-rush/lua/buildings.lua
msgid "Fishing boats unload at the harbour plaza. The catch goes straight from the quay to the market stalls."
msgstr "고기잡이배가 항구 광장에 짐을 내려요. 잡은 고기는 부두에서 곧장 시장 가판대로 가요."

#: games/relic-rush/lua/buildings.lua
msgid "Flower bed"
msgstr "화단"

#: games/relic-rush/lua/buildings.lua
msgid "Flower planter"
msgstr "화분 화단"

#: games/relic-rush/lua/buildings.lua
msgid "Flowering shrub"
msgstr "꽃 피는 관목"

#: games/relic-rush/lua/buildings.lua
msgid "Forest fern"
msgstr "숲 고사리"

#: games/relic-rush/lua/buildings.lua
msgid "Frangipani"
msgstr "플루메리아"

#: games/relic-rush/lua/buildings.lua
msgid "Fruit pickers keep a sleeping platform among the branches. A watcher with a rattle can turn a flock away before it strips the ripest tree."
msgstr "과일 따는 사람들이 가지 사이에 잠자리 단을 마련해 둬요. 딸랑이를 든 파수꾼이 가장 잘 익은 나무를 새 떼가 털기 전에 쫓아낼 수 있어요."

#: games/relic-rush/lua/buildings.lua
msgid "Garden bench"
msgstr "정원 벤치"

#: games/relic-rush/lua/buildings.lua
msgid "Garden swing"
msgstr "정원 그네"

#: games/relic-rush/lua/buildings.lua
msgid "Giant kapok"
msgstr "거대한 케이폭"

#: games/relic-rush/lua/buildings.lua
msgid "Giant stone head"
msgstr "거대한 석상 머리"

#: games/relic-rush/lua/buildings.lua
msgid "Glass greenhouse"
msgstr "유리 온실"

#: games/relic-rush/lua/buildings.lua
msgid "Golden idol"
msgstr "황금 우상"

#: games/relic-rush/lua/buildings.lua
msgid "Great aviary"
msgstr "대형 새장"

#: games/relic-rush/lua/buildings.lua
msgid "Hanging gardens"
msgstr "공중 정원"

#: games/relic-rush/lua/buildings.lua
msgid "Harbour lodge"
msgstr "항구 숙소"

#: games/relic-rush/lua/buildings.lua
msgid "Harbour plaza"
msgstr "항구 광장"

#: games/relic-rush/lua/buildings.lua
msgid "Herbalist's hut"
msgstr "약초사의 오두막"

#: games/relic-rush/lua/buildings.lua
msgid "Island growers bring fruit and grain to market. The stalls pack provisions in clay jars for the road."
msgstr "섬의 농부들이 과일과 곡식을 시장에 가져와요. 가판대에서 길 떠날 양식을 토기 단지에 담아 줘요."

#: games/relic-rush/lua/buildings.lua
msgid "Jade fountain"
msgstr "비취 분수"

#: games/relic-rush/lua/buildings.lua
msgid "Jade gazebo"
msgstr "비취 정자"

#: games/relic-rush/lua/buildings.lua
msgid "Jaguar guardian"
msgstr "재규어 수호상"

#: games/relic-rush/lua/buildings.lua
msgid "Jungle market"
msgstr "정글 시장"

#: games/relic-rush/lua/buildings.lua
msgid "Keeper's archive"
msgstr "관리인의 기록소"

#: games/relic-rush/lua/buildings.lua
msgid "Lantern post"
msgstr "등불 기둥"

#: games/relic-rush/lua/buildings.lua
msgid "Lighthouse"
msgstr "등대"

#: games/relic-rush/lua/buildings.lua
msgid "Lily pond"
msgstr "백합 연못"

#: games/relic-rush/lua/buildings.lua
msgid "Little fountain"
msgstr "작은 분수"

#: games/relic-rush/lua/buildings.lua
msgid "Mango tree"
msgstr "망고나무"

#: games/relic-rush/lua/buildings.lua
msgid "Market cart"
msgstr "시장 수레"

#: games/relic-rush/lua/buildings.lua
msgid "Mess hall"
msgstr "식당 막사"

#: games/relic-rush/lua/buildings.lua
msgid "Mossy boulders"
msgstr "이끼 낀 바위"

#: games/relic-rush/lua/buildings.lua
msgid "Palm hammock"
msgstr "야자 해먹"

#: games/relic-rush/lua/buildings.lua
msgid "Papaya tree"
msgstr "파파야 나무"

#: games/relic-rush/lua/buildings.lua
msgid "Parrot perch"
msgstr "앵무새 횃대"

#: games/relic-rush/lua/buildings.lua
msgid "Picnic rug"
msgstr "피크닉 돗자리"

#: games/relic-rush/lua/buildings.lua
msgid "Place this treasure anywhere on open grass."
msgstr "이 보물을 탁 트인 풀밭 아무 데나 놓으세요."

#: games/relic-rush/lua/buildings.lua
msgid "Porters use the lowest dry step to board a boat. As the tide rises they move their baskets up the stone stair, one landing at a time."
msgstr "짐꾼들은 가장 낮은 마른 계단에서 배에 올라요. 물이 차오르면 바구니를 돌계단 위로 한 단씩 옮겨요."

#: games/relic-rush/lua/buildings.lua
msgid "Quarry stone is squared and sorted here before it is traded to the island's builders."
msgstr "채석한 돌을 여기서 네모나게 다듬고 분류해서 섬의 건축가들에게 팔아요."

#: games/relic-rush/lua/buildings.lua
msgid "Quay steps"
msgstr "부두 계단"

#: games/relic-rush/lua/buildings.lua
msgid "Rainbow garden"
msgstr "무지개 정원"

#: games/relic-rush/lua/buildings.lua
msgid "Red hibiscus"
msgstr "붉은 히비스커스"

#: games/relic-rush/lua/buildings.lua
msgid "Relic museum"
msgstr "유물 박물관"

#: games/relic-rush/lua/buildings.lua
msgid "Riverside reeds"
msgstr "강가 갈대"

#: games/relic-rush/lua/buildings.lua
msgid "Rock spring"
msgstr "바위 샘"

#: games/relic-rush/lua/buildings.lua
msgid "Round jungle tree"
msgstr "둥근 정글 나무"

#: games/relic-rush/lua/buildings.lua
msgid "Round shrub"
msgstr "둥근 관목"

#: games/relic-rush/lua/buildings.lua
msgid "Rowboat"
msgstr "노 젓는 보트"

#: games/relic-rush/lua/buildings.lua
msgid "Ruined arch"
msgstr "폐허 아치"

#: games/relic-rush/lua/buildings.lua
msgid "Shipwrights salvage valuable cargo and sound timber from the hull while the tide is out."
msgstr "조선공들이 썰물 때 선체에서 값진 화물과 튼튼한 목재를 건져 내요."

#: games/relic-rush/lua/buildings.lua
msgid "Sight lines through the stone pillars help navigators mark the positions of stars throughout the year."
msgstr "돌기둥 사이로 보이는 시선이 항해사들이 일 년 내내 별의 위치를 표시하도록 도와줘요."

#: games/relic-rush/lua/buildings.lua
msgid "Signpost"
msgstr "이정표"

#: games/relic-rush/lua/buildings.lua
msgid "Spring well"
msgstr "샘 우물"

#: games/relic-rush/lua/buildings.lua
msgid "Star observatory"
msgstr "별 관측소"

#: games/relic-rush/lua/buildings.lua
msgid "Stilt house"
msgstr "수상 가옥"

#: games/relic-rush/lua/buildings.lua
msgid "Stone amphitheatre"
msgstr "돌 원형극장"

#: games/relic-rush/lua/buildings.lua
msgid "Stone idol"
msgstr "돌 우상"

#: games/relic-rush/lua/buildings.lua
msgid "Stone trading post"
msgstr "석조 교역소"

#: games/relic-rush/lua/buildings.lua
msgid "Sun obelisk"
msgstr "태양 오벨리스크"

#: games/relic-rush/lua/buildings.lua
msgid "Sundial"
msgstr "해시계"

#: games/relic-rush/lua/buildings.lua
msgid "Sunning turtle"
msgstr "햇볕 쬐는 거북"

#: games/relic-rush/lua/buildings.lua
msgid "Sunny daisies"
msgstr "햇살 데이지"

#: games/relic-rush/lua/buildings.lua
msgid "Supply crates"
msgstr "보급 상자"

#: games/relic-rush/lua/buildings.lua
msgid "Supply tent"
msgstr "보급 천막"

#: games/relic-rush/lua/buildings.lua
msgid "Temple cypress"
msgstr "신전 사이프러스"

#: games/relic-rush/lua/buildings.lua
msgid "Temple of the Sun"
msgstr "태양 신전"

#: games/relic-rush/lua/buildings.lua
msgid "Tender seedlings spend their first weeks under cover. The gardener opens the shelter early, before the midday heat can wilt a whole bed."
msgstr "여린 모종은 첫 몇 주를 덮개 아래서 보내요. 정원사는 한낮 더위가 화단 전체를 시들게 하기 전에 일찍 덮개를 열어요."

#: games/relic-rush/lua/buildings.lua
msgid "The amphitheatre gives the town a place for contests and public gatherings. Armourers set up their stalls at the entrance."
msgstr "원형극장은 마을에 대회와 공개 모임을 위한 자리를 마련해 줘요. 무구 장인들이 입구에 가판대를 세워요."

#: games/relic-rush/lua/buildings.lua
msgid "The archive keeps harbour plans and trade records dry. Carved rings serve as seals for official documents."
msgstr "기록소는 항구 도면과 교역 기록을 마른 채로 보관해요. 새긴 반지는 공문서의 인장으로 써요."

#: games/relic-rush/lua/buildings.lua
msgid "The camp gives excavation crews a place to sort supplies, mend tools and cook between shifts."
msgstr "야영지는 발굴대가 물자를 분류하고, 도구를 고치고, 교대 사이에 밥을 지을 곳이에요."

#: games/relic-rush/lua/buildings.lua
msgid "The harbour watch tracks the tide from this tower. Pilots use its signals to time a shallow crossing."
msgstr "항구 감시대는 이 탑에서 조수를 지켜봐요. 도선사들은 이 신호로 얕은 곳을 건널 때를 맞춰요."

#: games/relic-rush/lua/buildings.lua
msgid "The herbalist dries leaves on reed trays and keeps the roots in separate clay pots. A sprig tied to each lid tells an apprentice which plant grew it."
msgstr "약초사는 갈대 쟁반에 잎을 말리고 뿌리는 따로 토기 단지에 보관해요. 뚜껑마다 묶은 잔가지가 견습생에게 어떤 식물인지 알려 줘요."

#: games/relic-rush/lua/buildings.lua
msgid "The lodge gives visiting crews a dry berth and a place to prepare for their next departure."
msgstr "숙소는 찾아온 선원들에게 마른 잠자리와 다음 출항을 준비할 곳을 마련해 줘요."

#: games/relic-rush/lua/buildings.lua
msgid "The museum keeps the island's carvings and instruments together, where visitors can see how they were made."
msgstr "박물관은 섬의 조각품과 기구를 한곳에 모아 방문객이 어떻게 만들어졌는지 볼 수 있게 해요."

#: games/relic-rush/lua/buildings.lua
msgid "The sawbench turns logs into beams and planks for houses and boats."
msgstr "톱작업대가 통나무를 집과 배에 쓸 들보와 널빤지로 만들어요."

#: games/relic-rush/lua/buildings.lua
msgid "The stone lining keeps loose earth out of the spring. A low rim makes it easy to fill buckets."
msgstr "돌 테두리가 흙이 샘에 들어가지 않게 막아요. 낮은 가장자리 덕에 물통을 채우기 쉬워요."

#: games/relic-rush/lua/buildings.lua
msgid "The stream turns the millwheel. Inside, millstones grind the island's harvest into flour."
msgstr "시냇물이 물레방아를 돌려요. 안에서는 맷돌이 섬의 수확을 가루로 갈아요."

#: games/relic-rush/lua/buildings.lua
msgid "The temple courtyard hosts public ceremonies and feast days under the island's sun emblem."
msgstr "신전 안뜰에서는 섬의 태양 문장 아래 공개 의식과 축제일이 열려요."

#: games/relic-rush/lua/buildings.lua
msgid "Tide clock tower"
msgstr "조수 시계탑"

#: games/relic-rush/lua/buildings.lua
msgid "Tiki torch"
msgstr "티키 횃불"

#: games/relic-rush/lua/buildings.lua
msgid "Timber posts carry the sleeping floor above the flood line. A family can tie its boat to the steps and come home even when the lane is under water."
msgstr "목재 기둥이 잠자리 바닥을 침수선 위로 받쳐 줘요. 골목이 물에 잠겨도 가족은 계단에 배를 묶고 집에 돌아올 수 있어요."

#: games/relic-rush/lua/buildings.lua
msgid "Topiary ball"
msgstr "공 모양 전정수"

#: games/relic-rush/lua/buildings.lua
msgid "Toucan perch"
msgstr "큰부리새 횃대"

#: games/relic-rush/lua/buildings.lua
msgid "Trapper's cabin"
msgstr "사냥꾼의 오두막"

#: games/relic-rush/lua/buildings.lua
msgid "Trappers shelter here between trips. The cabin gives them a dry bench for repairing traps and gear."
msgstr "사냥꾼들은 여행 사이에 여기서 쉬어요. 오두막에는 덫과 장비를 고칠 마른 벤치가 있어요."

#: games/relic-rush/lua/buildings.lua
msgid "Treasure chest"
msgstr "보물 상자"

#: games/relic-rush/lua/buildings.lua
msgid "Twin palms"
msgstr "쌍둥이 야자"

#: games/relic-rush/lua/buildings.lua
msgid "Vine pergola"
msgstr "덩굴 퍼걸러"

#: games/relic-rush/lua/buildings.lua
msgid "Water from the spring flows through the fountain into a basin faced with green stone."
msgstr "샘물이 분수를 지나 초록 돌로 덮은 물받이로 흘러요."

#: games/relic-rush/lua/buildings.lua
msgid "Water mill"
msgstr "물레방앗간"

#: games/relic-rush/lua/buildings.lua
msgid "Water pump"
msgstr "물펌프"

#: games/relic-rush/lua/buildings.lua
msgid "Wild orchids"
msgstr "야생 난초"

#: games/relic-rush/lua/buildings.lua
msgid "Young palm"
msgstr "어린 야자"

#: games/relic-rush/lua/campaign.lua
msgid "Arch Gate"
msgstr "아치 문"

#: games/relic-rush/lua/campaign.lua
msgid "Beached Hull"
msgstr "뭍에 오른 선체"

#: games/relic-rush/lua/campaign.lua
msgid "Bell Cistern"
msgstr "종 저수조"

#: games/relic-rush/lua/campaign.lua
msgid "Bone Stair"
msgstr "뼈 계단"

#: games/relic-rush/lua/campaign.lua
msgid "Broken Aqueduct"
msgstr "무너진 수로"

#: games/relic-rush/lua/campaign.lua
msgid "Ceiba Roots"
msgstr "세이바 뿌리"

#: games/relic-rush/lua/campaign.lua
msgid "Cenote Ring"
msgstr "세노테 고리"

#: games/relic-rush/lua/campaign.lua
msgid "Chac Stair"
msgstr "찰 계단"

#: games/relic-rush/lua/campaign.lua
msgid "Choked Gateway"
msgstr "막힌 관문"

#: games/relic-rush/lua/campaign.lua
msgid "Clear every turquoise plaque."
msgstr "청록색 명판을 모두 지우세요."

#: games/relic-rush/lua/campaign.lua
msgid "Coiled Serpent"
msgstr "똬리 튼 뱀"

#: games/relic-rush/lua/campaign.lua
msgid "Colonnade Walk"
msgstr "기둥 회랑길"

#: games/relic-rush/lua/campaign.lua
msgid "Cormorant Rock"
