#: games/relic-rush/lua/buildings.lua
msgid "Picnic rug"
msgstr "Plaid de pique-nique"

#: games/relic-rush/lua/buildings.lua
msgid "Place this treasure anywhere on open grass."
msgstr "Place ce trésor n'importe où sur l'herbe libre."

#: games/relic-rush/lua/buildings.lua
msgid "Porters use the lowest dry step to board a boat. As the tide rises they move their baskets up the stone stair, one landing at a time."
msgstr "Les porteurs utilisent la marche sèche la plus basse pour monter à bord. Quand la marée monte, ils remontent leurs paniers sur l'escalier de pierre, un palier à la fois."

#: games/relic-rush/lua/buildings.lua
msgid "Quarry stone is squared and sorted here before it is traded to the island's builders."
msgstr "La pierre de carrière est équarrie et triée ici avant d'être vendue aux bâtisseurs de l'île."

#: games/relic-rush/lua/buildings.lua
msgid "Quay steps"
msgstr "Marches du quai"

#: games/relic-rush/lua/buildings.lua
msgid "Rainbow garden"
msgstr "Jardin arc-en-ciel"

#: games/relic-rush/lua/buildings.lua
msgid "Red hibiscus"
msgstr "Hibiscus rouge"

#: games/relic-rush/lua/buildings.lua
msgid "Relic museum"
msgstr "Musée des reliques"

#: games/relic-rush/lua/buildings.lua
msgid "Riverside reeds"
msgstr "Roseaux de la rive"

#: games/relic-rush/lua/buildings.lua
msgid "Rock spring"
msgstr "Source dans le rocher"

