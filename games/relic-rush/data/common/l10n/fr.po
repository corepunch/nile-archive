#: games/relic-rush/lua/buildings.lua
msgid "Frangipani"
msgstr "Frangipanier"

#: games/relic-rush/lua/buildings.lua
msgid "Fruit pickers keep a sleeping platform among the branches. A watcher with a rattle can turn a flock away before it strips the ripest tree."
msgstr "Les cueilleurs gardent une plateforme pour dormir dans les branches. Un guetteur muni d'une crécelle peut chasser une volée avant qu'elle ne dépouille l'arbre le plus mûr."

#: games/relic-rush/lua/buildings.lua
msgid "Garden bench"
msgstr "Banc de jardin"

#: games/relic-rush/lua/buildings.lua
