#: games/relic-rush/lua/buildings.lua
msgid "Ruined arch"
msgstr "Arche en ruine"

#: games/relic-rush/lua/buildings.lua
msgid "Shipwrights salvage valuable cargo and sound timber from the hull while the tide is out."
msgstr "Les charpentiers de marine récupèrent cargaison précieuse et bois sain dans la coque à marée basse."

#: games/relic-rush/lua/buildings.lua
msgid "Sight lines through the stone pillars help navigators mark the positions of stars throughout the year."
msgstr "Les lignes de visée entre les piliers de pierre aident les navigateurs à repérer la position des étoiles tout au long de l'année."

#: games/relic-rush/lua/buildings.lua
msgid "Signpost"
msgstr "Panneau indicateur"

#: games/relic-rush/lua/buildings.lua
msgid "Spring well"
msgstr "Puits de la source"

#: games/relic-rush/lua/buildings.lua
msgid "Star observatory"
msgstr "Observatoire des étoiles"

#: games/relic-rush/lua/buildings.lua
msgid "Stilt house"
msgstr "Maison sur pilotis"

#: games/relic-rush/lua/buildings.lua
msgid "Stone amphitheatre"
msgstr "Amphithéâtre de pierre"

#: games/relic-rush/lua/buildings.lua
