#: games/relic-rush/lua/buildings.lua
msgid "Frangipani"
msgstr "Frangipani"

#: games/relic-rush/lua/buildings.lua
msgid "Fruit pickers keep a sleeping platform among the branches. A watcher with a rattle can turn a flock away before it strips the ripest tree."
msgstr "Los recolectores de fruta tienen una plataforma para dormir entre las ramas. Un vigía con una carraca puede ahuyentar a una bandada antes de que pele el árbol más maduro."

