#: games/relic-rush/lua/buildings.lua
msgid "Cartographer's house"
msgstr "Casa del cartógrafo"

#: games/relic-rush/lua/buildings.lua
msgid "Cartographers combine soundings from different crews to mark reefs and channels on a single chart."
msgstr "Los cartógrafos reúnen los sondeos de distintas tripulaciones para marcar arrecifes y canales en una sola carta."

#: games/relic-rush/lua/buildings.lua
msgid "Clipped hedge block"
msgstr "Seto recortado"

#: games/relic-rush/lua/buildings.lua
msgid "Crews bring their own bowls to the long tables. One cook can feed a whole shift while the hearth is hot and have the grain soaking for the next."
msgstr "Las tripulaciones traen sus propios cuencos a las mesas largas. Un solo cocinero alimenta a todo un turno mientras el hogar está caliente y deja el grano en remojo para el siguiente."

#: games/relic-rush/lua/buildings.lua
msgid "Crews carry homing birds aboard to send messages back to shore. The loft keeps the birds safe between voyages."
msgstr "Las tripulaciones llevan palomas mensajeras a bordo para enviar noticias a tierra. El palomar las protege entre viaje y viaje."

#: games/relic-rush/lua/buildings.lua
msgid "Crystal cluster"
msgstr "Racimo de cristales"

#: games/relic-rush/lua/buildings.lua
msgid "Curious monkey"
msgstr "Mono curioso"

#: games/relic-rush/lua/buildings.lua
msgid "Dig site"
msgstr "Yacimiento"

#: games/relic-rush/lua/buildings.lua
msgid "Duck pond"
msgstr "Estanque de patos"

#: games/relic-rush/lua/buildings.lua
msgid "Each terrace drains into the bed below. Gardeners carry water to the top at dawn and plant the thirstiest herbs where the first runnel falls."
msgstr "Cada terraza desagua en el bancal de abajo. Los jardineros suben el agua a lo alto al amanecer y plantan las hierbas más sedientas donde cae el primer regato."

#: games/relic-rush/lua/buildings.lua
msgid "Expedition camp"
msgstr "Campamento de la expedición"

#: games/relic-rush/lua/buildings.lua
msgid "Expedition flag"
msgstr "Bandera de la expedición"

#: games/relic-rush/lua/buildings.lua
