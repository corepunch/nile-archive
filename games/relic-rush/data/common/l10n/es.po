#: games/relic-rush/lua/screens.lua
#, lua-format
msgid "%s from matches is banked on a win."
msgstr "%s de las combinaciones: se guarda al ganar."

#: games/relic-rush/lua/screens.lua
msgid "Chains"
msgstr "Cadenas"

#: games/relic-rush/lua/screens.lua
msgid "Clear every turquoise plaque to win. Match pieces on a plaque or hit it with a tool."
msgstr "Despeja todas las placas turquesa para ganar. Combina piezas sobre una placa o golpéala con una herramienta."

#: games/relic-rush/lua/screens.lua
msgid "Expedition complete"
msgstr "Expedición completada"

#: games/relic-rush/lua/screens.lua
msgid "Explorer's guide"
msgstr "Guía del explorador"

#: games/relic-rush/lua/screens.lua
msgid "Five in a line: rainbow gem"
msgstr "Cinco en línea: gema arcoíris"

#: games/relic-rush/lua/screens.lua
msgid "Four in a line: line gem"
msgstr "Cuatro en línea: gema de línea"

#: games/relic-rush/lua/screens.lua
#, lua-format
msgid "From expedition %d."
msgstr "De la expedición %d."

#: games/relic-rush/lua/screens.lua
msgid "Gold coins"
msgstr "Monedas de oro"

#: games/relic-rush/lua/screens.lua
msgid "Green plaques"
msgstr "Placas verdes"

#: games/relic-rush/lua/screens.lua
msgid "It keeps its color. Match it again to sweep its whole row or column."
msgstr "Conserva su color. Combínala otra vez para barrer toda su fila o columna."

#: games/relic-rush/lua/screens.lua
msgid "Leaves, flowers and amphoras"
msgstr "Hojas, flores y ánforas"

#: games/relic-rush/lua/screens.lua
msgid "Line up 3+ pieces"
msgstr "Alinea 3 o más piezas"

#: games/relic-rush/lua/screens.lua
msgid "Match resource pieces and win to bank Coins, Supplies and Food."
msgstr "Combina piezas de recursos y gana para guardar Monedas, Provisiones y Comida."

#: games/relic-rush/lua/screens.lua
msgid "Match straight lines horizontally or vertically."
msgstr "Combina líneas rectas en horizontal o en vertical."

#: games/relic-rush/lua/screens.lua
msgid "Match the chained piece or hit it with a tool. If the cell has a plaque, clear it with another hit."
msgstr "Combina la pieza encadenada o golpéala con una herramienta. Si la casilla tiene una placa, despéjala con otro golpe."

#: games/relic-rush/lua/screens.lua
msgid "Match twice to clear a green plaque. Its first hit turns it turquoise."
msgstr "Combina dos veces para despejar una placa verde. El primer golpe la vuelve turquesa."

#: games/relic-rush/lua/screens.lua
msgid "Replay complete"
msgstr "Repetición completada"

#. TRANSLATORS: %s is a building's name, then two sentences: how the bonus charges and what it does
