#: games/relic-rush/lua/buildings.lua
msgid "A brazier above the harbour marks the entrance at night, when the reefs are hardest to see."
msgstr "Un brasero sobre el puerto marca la entrada de noche, cuando los arrecifes son más difíciles de ver."

