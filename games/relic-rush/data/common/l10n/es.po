#: games/relic-rush/lua/buildings.lua
msgid "Fan palm"
msgstr "Palmera abanico"

#: games/relic-rush/lua/buildings.lua
msgid "Field telescope"
msgstr "Telescopio de campo"

#: games/relic-rush/lua/buildings.lua
msgid "Fishing boats unload at the harbour plaza. The catch goes straight from the quay to the market stalls."
msgstr "Los barcos de pesca descargan en la plaza del puerto. La pesca va directa del muelle a los puestos del mercado."

