#: games/relic-rush/lua/buildings.lua
msgid "Place this treasure anywhere on open grass."
msgstr "Coloca este tesoro en cualquier lugar del césped libre."

#: games/relic-rush/lua/buildings.lua
msgid "Porters use the lowest dry step to board a boat. As the tide rises they move their baskets up the stone stair, one landing at a time."
msgstr "Los porteadores usan el escalón seco más bajo para subir a un barco. Con la marea creciente suben sus cestas por la escalera de piedra, un rellano cada vez."

#: games/relic-rush/lua/buildings.lua
msgid "Quarry stone is squared and sorted here before it is traded to the island's builders."
msgstr "Aquí se escuadra y clasifica la piedra de cantera antes de venderla a los constructores de la isla."

#: games/relic-rush/lua/buildings.lua
msgid "Quay steps"
msgstr "Escalones del muelle"

#: games/relic-rush/lua/buildings.lua
